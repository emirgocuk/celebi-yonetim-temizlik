    // Load Inquiries (PocketBase Primary + LocalStorage Fallback)
    let activeInquiries = [];
    let isPbInquiriesMode = false;

    async function loadInquiries() {
      let inquiries = [];
      isPbInquiriesMode = false;

      if (inquiriesContainer) {
        inquiriesContainer.innerHTML = `<div class="p-8 text-center text-slate-400 text-xs">Talepler yükleniyor...</div>`;
      }

      try {
        let res = await fetch(`${PB_BASE_URL}/api/collections/teklif_talepleri/records?page=1&perPage=100&sort=-created`);
        if (!res.ok) {
          res = await fetch(`${PB_BASE_URL}/api/collections/teklif_talepleri/records?page=1&perPage=100`);
        }
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        isPbInquiriesMode = true;
        inquiries = (data.items || []).map((rec) => {
          let createdLabel = 'Yeni';
          if (rec.created) {
            try {
              createdLabel = new Date(rec.created).toLocaleString('tr-TR', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit',
              });
            } catch (_) {
              createdLabel = rec.created;
            }
          }
          return {
            id: rec.id,
            fullName: rec.fullName || '',
            phone: rec.phone || '',
            serviceType: rec.serviceType || '',
            buildingUnits: rec.buildingUnits || '-',
            message: rec.message || '',
            status: rec.status || 'Yeni',
            channel: rec.channel || 'Web Sitesi Teklif Formu',
            landingPage: rec.landingPage || '',
            utmSource: rec.utmSource || '',
            utmMedium: rec.utmMedium || '',
            utmCampaign: rec.utmCampaign || '',
            utmTerm: rec.utmTerm || '',
            gclid: rec.gclid || '',
            fbclid: rec.fbclid || '',
            referrer: rec.referrer || '',
            created: createdLabel,
            _fromPb: true,
          };
        });
      } catch (err) {
        try {
          const saved = localStorage.getItem('celebi_quote_inquiries');
          inquiries = saved ? JSON.parse(saved) : defaultSeedInquiries;
        } catch (_) {
          inquiries = defaultSeedInquiries;
        }
      }

      activeInquiries = inquiries;
      const totalCount = inquiries.length;
      const pendingCount = inquiries.filter((i) => (i.status || 'Yeni') === 'Yeni').length;

      if (statTotal) statTotal.innerText = totalCount;
      if (statPending) statPending.innerText = pendingCount;
      if (tabBadge) tabBadge.innerText = pendingCount;

      if (!inquiriesContainer) return;
      if (inquiries.length === 0) {
        inquiriesContainer.innerHTML = `<div class="p-8 text-center text-slate-400 text-xs">Henüz gelen bir teklif talebi bulunmuyor. Siteden gelen yeni talepler burada anlık olarak listelenecektir.</div>`;
        return;
      }

      inquiriesContainer.innerHTML = inquiries
        .map((item, idx) => {
          const statusColors = {
            'Yeni': 'bg-emerald-100 text-emerald-800 border-emerald-200',
            'İncelendi': 'bg-sky-100 text-sky-800 border-sky-200',
            'Teklif Verildi': 'bg-slate-100 text-slate-800 border-slate-300',
          };
          const safeStatus = item.status || 'Yeni';
          const badgeClass = statusColors[safeStatus] || 'bg-slate-100 text-slate-800';
          const cleanPhone = String(item.phone || '').replace(/[^0-9]/g, '');
          const waPhone = cleanPhone.startsWith('90') ? cleanPhone : '90' + cleanPhone.replace(/^0/, '');
          const waText = encodeURIComponent(`Merhaba ${item.fullName || ''}, Çelebi Yönetim ve Temizlik olarak web sitemiz üzerinden ilettiğiniz ${item.serviceType || 'hizmet'} teklif talebiniz için yazıyoruz.`);

          const attrBadges = [];
          if (item.gclid) {
            attrBadges.push(`<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-300">🎯 Google Ads</span>`);
          } else if (item.fbclid) {
            attrBadges.push(`<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-100 text-indigo-900 border border-indigo-300">📘 Meta Ads</span>`);
          }
          if (item.utmSource || item.utmCampaign) {
            const utmLabel = [item.utmSource, item.utmMedium, item.utmCampaign].filter(Boolean).join(' / ');
            attrBadges.push(`<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-violet-50 text-violet-800 border border-violet-200">📡 ${escapeHtml(utmLabel)}</span>`);
          }
          if (item.utmTerm) {
            attrBadges.push(`<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">🔍 ${escapeHtml(item.utmTerm)}</span>`);
          }
          if (item.landingPage) {
            attrBadges.push(`<span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-slate-100 text-slate-600 border border-slate-200">📄 ${escapeHtml(item.landingPage)}</span>`);
          }

          return `
            <div class="p-6 flex flex-col lg:flex-row lg:items-center justify-between gap-4 hover:bg-slate-50/80 transition-colors">
              <div class="space-y-2 max-w-2xl">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-sm font-bold text-slate-900">${escapeHtml(item.fullName)}</span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold border ${badgeClass}">
                    ${escapeHtml(safeStatus)}
                  </span>
                  ${item.channel ? `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">💬 ${escapeHtml(item.channel)}</span>` : ''}
                  <span class="text-xs text-slate-400">• ${escapeHtml(item.created || 'Yeni')}</span>
                </div>

                <div class="flex flex-wrap items-center gap-3 text-xs text-slate-600">
                  <span class="font-bold text-sky-800 bg-sky-50 px-2 py-0.5 rounded">Hizmet: ${escapeHtml(item.serviceType)}</span>
                  ${item.buildingUnits && item.buildingUnits !== '-' ? `<span>Birim/Alan: <strong>${escapeHtml(item.buildingUnits)}</strong></span>` : ''}
                  <span>Tel: <strong>${escapeHtml(item.phone)}</strong></span>
                </div>

                ${attrBadges.length ? `<div class="flex flex-wrap items-center gap-1.5 pt-0.5">${attrBadges.join('')}</div>` : ''}

                ${item.message ? `<p class="text-xs text-slate-600 italic bg-white p-2.5 rounded-xl border border-slate-200/80">"${escapeHtml(item.message)}"</p>` : ''}
              </div>

              <div class="flex flex-wrap items-center gap-2 shrink-0">
                <a href="https://wa.me/${waPhone}?text=${waText}" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 text-xs font-bold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 rounded-xl transition-all">WhatsApp'tan Yaz</a>
                <a href="tel:${escapeHtml(item.phone)}" class="px-3 py-1.5 text-xs font-bold text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-xl transition-all">Ara</a>
                <button type="button" data-action="toggle-status" data-index="${idx}" class="px-3 py-1.5 text-xs font-bold text-sky-700 bg-sky-50 hover:bg-sky-100 border border-sky-200 rounded-xl transition-all cursor-pointer">Durum Değiştir</button>
                <button type="button" data-action="delete" data-index="${idx}" class="p-1.5 text-slate-400 hover:text-red-600 rounded-lg transition-colors cursor-pointer" title="Sil">✕</button>
              </div>
            </div>
          `;
        })
        .join('');

      inquiriesContainer.querySelectorAll('[data-action="toggle-status"]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const index = parseInt(btn.getAttribute('data-index'), 10);
          const target = activeInquiries[index];
          if (!target) return;
          const current = target.status || 'Yeni';
          const nextStatus = current === 'Yeni' ? 'İncelendi' : current === 'İncelendi' ? 'Teklif Verildi' : 'Yeni';

          if (target._fromPb && target.id) {
            try {
              const res = await fetch(`${PB_BASE_URL}/api/collections/teklif_talepleri/records/${target.id}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: nextStatus }),
              });
              if (!res.ok) throw new Error('HTTP ' + res.status);
            } catch (err) {
              alert('Durum güncellenemedi: ' + (err.message || err));
              return;
            }
          } else {
            target.status = nextStatus;
            try { localStorage.setItem('celebi_quote_inquiries', JSON.stringify(activeInquiries)); } catch (_) {}
          }
          loadInquiries();
        });
      });

      inquiriesContainer.querySelectorAll('[data-action="delete"]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const index = parseInt(btn.getAttribute('data-index'), 10);
          const target = activeInquiries[index];
          if (!target) return;
          if (!confirm('Bu teklif kaydını silmek istediğinize emin misiniz?')) return;

          if (target._fromPb && target.id) {
            try {
              const res = await fetch(`${PB_BASE_URL}/api/collections/teklif_talepleri/records/${target.id}`, {
                method: 'DELETE',
              });
              if (!res.ok) throw new Error('HTTP ' + res.status);
            } catch (err) {
              alert('Kayıt silinemedi: ' + (err.message || err));
              return;
            }
          } else {
            activeInquiries.splice(index, 1);
            try { localStorage.setItem('celebi_quote_inquiries', JSON.stringify(activeInquiries)); } catch (_) {}
          }
          loadInquiries();
        });
      });
    }

    if (refreshInquiriesBtn) {
      refreshInquiriesBtn.addEventListener('click', () => {
        loadInquiries();
      });
    }

    if (clearInquiriesBtn) {
      clearInquiriesBtn.addEventListener('click', async () => {
        if (!confirm('Tüm teklif kayıtlarını silmek istediğinize emin misiniz?')) return;
        if (isPbInquiriesMode) {
          for (const item of activeInquiries) {
            if (item._fromPb && item.id) {
              try {
                await fetch(`${PB_BASE_URL}/api/collections/teklif_talepleri/records/${item.id}`, {
                  method: 'DELETE',
                });
              } catch (_) {}
            }
          }
        }
        try { localStorage.setItem('celebi_quote_inquiries', JSON.stringify([])); } catch (_) {}
        loadInquiries();
      });
    }

    // ==========================================
    // CONTENT ENGINE (CEO & OTOMATIK HABER MOTORU)
    // ==========================================

    // ==========================================
    // ⏱️ OTONOM ZAMANLAYICI & TIMER YÖNETİMİ
    // ==========================================
    let timerRecordId = null;
    let timerData = null;

    const timerToggleActive = document.getElementById('timer-toggle-active');
    const timerStatusText = document.getElementById('timer-status-text');
    const timerLiveBadge = document.getElementById('timer-live-badge');
    const timerSelectFrequency = document.getElementById('timer-select-frequency');
    const timerSelectDistrict = document.getElementById('timer-select-district');
    const timerCountdown = document.getElementById('timer-countdown');
    const timerLastRun = document.getElementById('timer-last-run');
    const timerTotalCount = document.getElementById('timer-total-count');
    const timerQueueCount = document.getElementById('timer-queue-count');
    const timerLastArticle = document.getElementById('timer-last-article');
    const btnSaveTimerSettings = document.getElementById('btn-save-timer-settings');
    const btnForcePublishNow = document.getElementById('btn-force-publish-now');
    const btnForceText = document.getElementById('btn-force-text');

    async function loadTimerSettings() {
      try {
        const res = await fetch(`${PB_BASE_URL}/api/collections/otomatik_yayin_ayarlari/records`);
        if (!res.ok) throw new Error('Timer fetch error');
        const data = await res.json();
        if (data.items && data.items.length > 0) {
          timerData = data.items[0];
          timerRecordId = timerData.id;
          renderTimerUI(timerData);
        }
      } catch (err) {
        console.warn('Timer settings could not be fetched:', err);
      }
      loadQueueStats();
    }

    async function loadQueueStats() {
      try {
        const qRes = await fetch(`${PB_BASE_URL}/api/collections/seo_keywords/records?page=1&perPage=1&filter=used%3Dfalse`);
        if (qRes.ok) {
          const qData = await qRes.json();
          if (timerQueueCount) timerQueueCount.innerText = qData.totalItems ?? 0;
        }
      } catch (e) {}
    }

    function renderTimerUI(data) {
      if (!data) return;

      const isActive = data.aktif === true;
      if (timerToggleActive) timerToggleActive.checked = isActive;
      if (timerStatusText) {
        timerStatusText.innerText = isActive ? 'AÇIK' : 'KAPALI';
        timerStatusText.className = isActive ? 'text-xs font-bold text-emerald-700' : 'text-xs font-bold text-slate-400';
      }
      if (timerLiveBadge) {
        timerLiveBadge.className = isActive
          ? 'px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200 flex items-center gap-1'
          : 'px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-500 border border-slate-200 flex items-center gap-1';
        timerLiveBadge.innerHTML = isActive
          ? '<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Zamanlayıcı Aktif'
          : '<span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> Durduruldu';
      }

      if (timerSelectFrequency && data.siklik) {
        timerSelectFrequency.value = data.siklik;
      }

      if (timerSelectDistrict && data.hedefIlce) {
        timerSelectDistrict.value = data.hedefIlce;
      }

      if (timerTotalCount) timerTotalCount.innerText = data.toplamUretilen ?? 0;
      if (timerLastArticle && data.sonBaslik) {
        timerLastArticle.innerText = `Son Yayın: "${data.sonBaslik}"`;
      }
      if (timerLastRun && data.sonCalisma) {
        timerLastRun.innerText = `Son: ${data.sonCalisma}`;
      }

      updateCountdownDisplay();
    }

    function updateCountdownDisplay() {
      if (!timerData || !timerCountdown) return;
      if (!timerData.aktif) {
        timerCountdown.innerHTML = '<span class="text-xs text-slate-400 font-bold">Durduruldu (Kapalı)</span>';
        return;
      }

      const lastStr = timerData.sonCalisma;
      if (!lastStr) {
        timerCountdown.innerHTML = '<span class="text-xs text-emerald-600 font-bold">İlk çalışma bekleniyor...</span>';
        return;
      }

      const intervals = {
        '1h': 3600,
        '3h': 10800,
        '6h': 21600,
        '12h': 43200,
        '24h': 86400,
        '48h': 172800,
        '72h': 259200
      };
      const reqSec = intervals[timerData.siklik] || 172800;

      const lastDt = new Date(lastStr.replace(' ', 'T'));
      const nextDt = new Date(lastDt.getTime() + reqSec * 1000);
      const now = new Date();
      const diffSec = Math.floor((nextDt.getTime() - now.getTime()) / 1000);

      if (diffSec <= 0) {
        timerCountdown.innerHTML = '<span class="text-xs text-emerald-600 font-bold animate-pulse">⚡ Sıradaki periyot hazır</span>';
      } else {
        const hours = Math.floor(diffSec / 3600);
        const mins = Math.floor((diffSec % 3600) / 60);
        const secs = diffSec % 60;
        timerCountdown.innerHTML = `<span class="text-sm">⏳</span> <span>${hours > 0 ? hours + 's ' : ''}${mins}dk ${secs}sn</span>`;
      }
    }

    if (timerToggleActive) {
      timerToggleActive.addEventListener('change', () => {
        if (timerStatusText) {
          timerStatusText.innerText = timerToggleActive.checked ? 'AÇIK' : 'KAPALI';
          timerStatusText.className = timerToggleActive.checked ? 'text-xs font-bold text-emerald-700' : 'text-xs font-bold text-slate-400';
        }
      });
    }

    if (btnSaveTimerSettings) {
      btnSaveTimerSettings.addEventListener('click', async () => {
        if (!timerRecordId) {
          alert('Zamanlayıcı kaydı bulunamadı!');
          return;
        }

        btnSaveTimerSettings.disabled = true;
        btnSaveTimerSettings.innerText = 'Kaydediliyor...';

        try {
          const payload = {
            aktif: timerToggleActive ? timerToggleActive.checked : true,
            siklik: timerSelectFrequency ? timerSelectFrequency.value : '6h',
            hedefIlce: timerSelectDistrict ? timerSelectDistrict.value : 'auto'
          };

          const res = await fetch(`${PB_BASE_URL}/api/collections/otomatik_yayin_ayarlari/records/${timerRecordId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (!res.ok) throw new Error('Kaydedilemedi');
          timerData = await res.json();
          renderTimerUI(timerData);
          alert('✓ Otomatik yayın zamanlayıcı ayarları başarıyla güncellendi!');
        } catch (err) {
          alert('Ayarlar kaydedilirken hata oluştu: ' + err.message);
        } finally {
          btnSaveTimerSettings.disabled = false;
          btnSaveTimerSettings.innerText = '💾 Zamanlayıcı Ayarlarını Kaydet';
        }
      });
    }

    if (btnForcePublishNow) {
      btnForcePublishNow.addEventListener('click', async () => {
        if (!confirm('Hemen bir sonraki konuyu otomatik üretip PocketBase\'e yayınlamak istiyor musunuz?')) return;

        btnForcePublishNow.disabled = true;
        if (btnForceText) btnForceText.innerText = 'Yayınlanıyor... Lütfen Bekleyin ⚡';

        try {
          if (timerRecordId) {
            await fetch(`${PB_BASE_URL}/api/collections/otomatik_yayin_ayarlari/records/${timerRecordId}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ tetikle: true })
            });
          }

          alert('✓ Tetikleme sinyali sunucuya iletildi! Sistem sıradaki makaleyi üretiyor, birkaç saniye içinde "Yazılar" listenizde görünecektir.');
          setTimeout(() => {
            loadTimerSettings();
            loadCeArticles();
            loadCeKeywords();
          }, 3000);
        } catch (err) {
          alert('Tetikleme hatası: ' + err.message);
        } finally {
          btnForcePublishNow.disabled = false;
          if (btnForceText) btnForceText.innerText = 'Şimdi Otomatik Yayınla (Tetikle)';
        }
      });
    }

    setInterval(updateCountdownDisplay, 1000);
    setInterval(loadTimerSettings, 30000);

    function slugify(text) {
      const trMap = { 'ç':'c', 'Ç':'c', 'ğ':'g', 'Ğ':'g', 'ı':'i', 'İ':'i', 'ö':'o', 'Ö':'o', 'ş':'s', 'Ş':'s', 'ü':'u', 'Ü':'u' };
      return text.split('').map(c => trMap[c] || c).join('').toLowerCase().replace(/[^a-z0-9\s-]/g, '').trim().replace(/\s+/g, '-').replace(/-+/g, '-');
    }

    // Load Keywords from PocketBase seo_keywords
    async function loadCeKeywords() {
      if (!ceKeywordSelect) return;
      try {
        const res = await fetch(`${PB_BASE_URL}/api/collections/seo_keywords/records?page=1&perPage=50&sort=-priority`);
        if (!res.ok) throw new Error('PB error');
        const data = await res.json();
        if (data.items && data.items.length > 0) {
          ceKeywordSelect.innerHTML = `
            <option value="">-- Kuyruktan Konu Seçin (${data.items.length} Konu Mevcut) --</option>
            ${data.items.map(k => `
              <option value="${k.keyword}" data-district="${k.targetDistrict || 'Çukurova'}" data-category="${k.category || 'Site Yönetimi'}" data-id="${k.id}">
                ${k.used ? '✓ (Kullanıldı)' : '⚡ (Hazır)'} ${k.keyword} [${k.targetDistrict || 'Adana'}]
              </option>
            `).join('')}
          `;
          return;
        }
      } catch (err) {}

      // Fallback local list
      ceKeywordSelect.innerHTML = `
        <option value="">-- Kuyruktan Konu Seçin --</option>
        <option value="Adana Site Yönetimi Şirketleri ve Fiyatları">Adana Site Yönetimi Şirketleri ve Fiyatları</option>
        <option value="Apartman Aidatını Ödemeyen Komşuya İcra Takibi Nasıl Yapılır?">Apartman Aidatını Ödemeyen Komşuya İcra Takibi</option>
        <option value="Kat Mülkiyeti Kanununa Göre Yönetici Seçimi ve Genel Kurul Süreci">Kat Mülkiyeti Kanununa Göre Yönetici Seçimi</option>
        <option value="Adana Çukurova Profesyonel Ofis ve İş Yeri Temizliği">Adana Çukurova Profesyonel Ofis Temizliği</option>
        <option value="İnşaat ve Tadilat Sonrası Anahtar Teslim Temizlik">İnşaat ve Tadilat Sonrası Anahtar Teslim Temizlik</option>
      `;
    }

    if (ceBtnRefreshKeywords) {
      ceBtnRefreshKeywords.addEventListener('click', () => {
        loadCeKeywords();
      });
    }

    if (ceKeywordSelect) {
      ceKeywordSelect.addEventListener('change', () => {
        const val = ceKeywordSelect.value;
        if (val && ceCustomTopic) {
          ceCustomTopic.value = val;
          const opt = ceKeywordSelect.selectedOptions[0];
          if (opt && opt.getAttribute('data-district') && ceTargetDistrict) {
            ceTargetDistrict.value = opt.getAttribute('data-district');
          }
        }
      });
    }

    // Quality Gate Live Check
    function runQualityGateCheck() {
      const html = ceBodyHtml ? ceBodyHtml.value : '';
      const text = html.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
      const words = text ? text.split(' ').filter(w => w.length > 0).length : 0;
      const h2Count = (html.match(/<h2[^>]*>.*?<\/h2>/gi) || []).length;
      
      const lower = html.toLowerCase();
      const hasCta = (lower.includes('çelebi') || lower.includes('celebi')) && 
                     (lower.includes('322') || lower.includes('535') || lower.includes('533') || lower.includes('whatsapp') || lower.includes('teklif'));
      const hasLinks = html.includes('celebi-internal-links');

      if (badgeWords) {
        badgeWords.innerText = `📝 ${words} Kelime ${words >= 200 ? '✓' : '(Min 200)'}`;
        badgeWords.className = words >= 200
          ? 'px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold'
          : 'px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold';
      }

      if (badgeH2) {
        badgeH2.innerText = `📌 ${h2Count} H2 Başlık ${h2Count >= 3 ? '✓' : '(Min 3)'}`;
        badgeH2.className = h2Count >= 3
          ? 'px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold'
          : 'px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold';
      }

      if (badgeCta) {
        badgeCta.innerText = hasCta ? '📞 Çelebi CTA: Var ✓' : '📞 Çelebi CTA: Eksik ⚠️';
        badgeCta.className = hasCta
          ? 'px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold'
          : 'px-2.5 py-1 rounded-lg bg-red-500/20 text-red-300 border border-red-500/30 font-bold';
      }

      if (badgeLinks) {
        badgeLinks.innerText = hasLinks ? '🔗 İç Linkler: Var ✓' : '🔗 İç Linkler: Yok';
        badgeLinks.className = hasLinks
          ? 'px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold'
          : 'px-2.5 py-1 rounded-lg bg-slate-500/20 text-slate-300 border border-slate-500/30 font-bold';
      }

      if (cePreviewBox) {
        cePreviewBox.innerHTML = html;
      }
    }

    if (ceBodyHtml) {
      ceBodyHtml.addEventListener('input', runQualityGateCheck);
    }

    // Toggle Preview
    if (ceBtnPreviewToggle && cePreviewBox) {
      ceBtnPreviewToggle.addEventListener('click', () => {
        cePreviewBox.classList.toggle('hidden');
      });
    }

    // Generator Trigger
    if (ceBtnGenerate) {
      ceBtnGenerate.addEventListener('click', async () => {
        const topic = (ceCustomTopic ? ceCustomTopic.value.trim() : '') || (ceKeywordSelect ? ceKeywordSelect.value : '');
        if (!topic) {
          alert('Lütfen bir anahtar kelime seçin veya özel konu girin!');
          return;
        }

        const district = ceTargetDistrict ? ceTargetDistrict.value : 'Çukurova';
        const modeEl = document.querySelector('input[name="ce-mode"]:checked');
        const mode = modeEl ? modeEl.value : 'hybrid';
        const apiKey = getActiveOpenRouterKey();

        ceBtnGenerate.disabled = true;
        if (ceBtnGenerateText) ceBtnGenerateText.innerText = 'Makale Üretiliyor... Lütfen Bekleyin ⚡';

        try {
          // Normalize district prefix and clean redundant repetitions
          const distClean = (district || 'Çukurova').trim();
          let prefix = `Adana ${distClean} Genelinde`;
          if (distClean === 'Adana Geneli' || distClean === 'Genel' || distClean === 'auto' || distClean === 'Adana') {
            prefix = 'Adana Genelinde';
          } else if (distClean.toLowerCase().startsWith('adana ')) {
            prefix = `${distClean} Genelinde`;
          }

          let cleanTopic = topic.trim();
          if (distClean !== 'Adana Geneli' && distClean !== 'Genel' && distClean !== 'auto') {
            cleanTopic = cleanTopic.replace(new RegExp(`^(Adana\\s+)?${distClean}\\s*`, 'i'), '');
          }
          cleanTopic = cleanTopic.replace(/^Adana\s+(Geneli\s+)?/i, '');
          cleanTopic = cleanTopic.replace(/^Genelinde\s*/i, '');
          cleanTopic = cleanTopic ? (cleanTopic.charAt(0).toUpperCase() + cleanTopic.slice(1)) : topic;

          const isCleaning = /(temizlik|merdiven|tadilat|inşaat|hijyen|ofis|cam|vinç|depo|dezenfeksiyon|klinik|plaza|dış cephe|boş ev|daire temizli)/i.test(cleanTopic);
          const isLegal = /(aidat|icra|kmk|kat mülkiyeti|karar defteri|genel kurul|yönetici seçimi|noter|borç|dava|işletme projesi|hukuk|kanun|sözleşme)/i.test(cleanTopic);
          const autoCat = isCleaning ? 'Temizlik' : isLegal ? 'Hukuk & Mevzuat' : 'Site Yönetimi';
          const suffix = isCleaning ? 'Hizmeti ve Fiyat Rehberi' : isLegal ? 'KMK Uygulama Rehberi' : 'Adana Yönetim Rehberi';

          let generatedTitle = (cleanTopic.includes(':') || cleanTopic.includes('?'))
            ? `${prefix} ${cleanTopic}`
            : `${prefix} ${cleanTopic}: ${suffix}`;

          generatedTitle = generatedTitle.replace(/\bAdana\s+Adana\b/gi, 'Adana');
          generatedTitle = generatedTitle.replace(/\bAdana\s+Geneli\s+Genelinde\b/gi, 'Adana Genelinde');

          const generatedSlug = `${slugify(generatedTitle)}-${Date.now().toString().slice(-4)}`;
          
          const canonicalLinksBlock = `
