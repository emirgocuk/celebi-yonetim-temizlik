---
import { COMPANY_INFO } from '@/lib/fallback-data';

interface Props {
  contextLabel?: string;
  serviceType?: string;
  heading?: string;
  subtext?: string;
  compact?: boolean;
}

const {
  contextLabel = 'Web Sitesi Hızlı Arama',
  serviceType = 'Site & Apartman Yönetimi',
  heading = 'Uzun Form Doldurmayın — Sizi 5 Dakikada Arayalım',
  subtext = 'Numaranızı bırakın, Adana yönetim uzmanımız hemen geri dönüş yapıp tahmini işletme maliyetinizi paylaşsın.',
  compact = false,
} = Astro.props;
---

<section class={compact ? 'my-8' : 'py-6 sm:py-8 bg-white'}>
  <div class={compact ? '' : 'max-w-7xl mx-auto px-4 sm:px-6'}>
    <div class="p-5 sm:p-7 rounded-3xl bg-gradient-to-r from-slate-900 via-slate-900 to-[#004AAD] text-white shadow-xl border border-slate-800 relative overflow-hidden">
      <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-5">
        <div class="max-w-xl space-y-1.5">
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>5 Dakikada Uzman Geri Araması</span>
          </div>
          <h2 class="text-lg sm:text-xl font-extrabold text-white tracking-tight leading-snug">
            {heading}
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            {subtext}
          </p>
        </div>

        <div class="w-full lg:w-auto lg:min-w-[430px]">
          <form
            class="quick-callback-form flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5"
            data-context={contextLabel}
            data-service={serviceType}
          >
            <input
              type="tel"
              name="phone"
              required
              autocomplete="tel"
              placeholder="05XX XXX XX XX"
              aria-label="Telefon Numaranız"
              class="flex-1 px-4 py-3 text-sm font-semibold rounded-2xl bg-white text-slate-900 placeholder:text-slate-400 border border-white/80 focus:outline-none focus:ring-2 focus:ring-sky-400"
            />
            <button
              type="submit"
              class="px-5 py-3 rounded-2xl text-xs sm:text-sm font-extrabold text-slate-950 bg-emerald-400 hover:bg-emerald-300 active:scale-95 transition-all shadow-md cursor-pointer whitespace-nowrap"
            >
              Beni 5 Dakikada Arayın →
            </button>
          </form>

          <div class="qc-feedback hidden mt-2.5 p-3 rounded-xl text-xs font-semibold"></div>

          <div class="mt-2.5 flex flex-wrap items-center justify-between gap-2 text-[11px] text-slate-300">
            <span>Veya doğrudan arayın:</span>
            <a
              href={`tel:${COMPANY_INFO.landlinePhone}`}
              class="font-bold text-white hover:text-sky-300 underline decoration-sky-400/60"
            >
              {COMPANY_INFO.landlineFormatted}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const forms = document.querySelectorAll('.quick-callback-form');
    if (!forms.length) return;

    const pbBase =
      window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
        ? 'http://127.0.0.1:8090'
        : '';

    forms.forEach((form) => {
      if (form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      const input = form.querySelector('input[name="phone"]');
      const btn = form.querySelector('button[type="submit"]');
      const feedback = form.parentElement?.querySelector('.qc-feedback');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const rawPhone = (input?.value || '').trim();
        const digits = rawPhone.replace(/[^0-9]/g, '');

        if (digits.length < 10) {
          if (feedback) {
            feedback.className = 'qc-feedback mt-2.5 p-2.5 rounded-xl text-xs font-semibold bg-red-500/20 text-red-100 border border-red-400/40 block';
            feedback.innerText = 'Lütfen en az 10 haneli geçerli bir telefon numarası giriniz.';
          }
          return;
        }

        const contextLabel = form.getAttribute('data-context') || 'Web Sitesi Hızlı Arama';
        const serviceType = form.getAttribute('data-service') || 'Site & Apartman Yönetimi';
        const attr = (typeof window.celebiGetAttribution === 'function' ? window.celebiGetAttribution() : {}) || {};

        const pbPayload = {
          fullName: 'Hızlı Geri Arama Talebi',
          phone: rawPhone,
          serviceType,
          buildingUnits: '-',
          message: contextLabel,
          status: 'Yeni',
          channel: '5 Dk Hızlı Geri Arama',
          landingPage: attr.landingPage || window.location.pathname,
          utmSource: attr.utmSource || '',
          utmMedium: attr.utmMedium || '',
          utmCampaign: attr.utmCampaign || '',
          utmTerm: attr.utmTerm || '',
          gclid: attr.gclid || '',
          fbclid: attr.fbclid || '',
          referrer: attr.referrer || '',
        };

        try {
          const existing = JSON.parse(localStorage.getItem('celebi_quote_inquiries') || '[]');
          existing.unshift({
            id: 'talep_' + Date.now(),
            ...pbPayload,
            created: new Date().toLocaleString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }),
          });
          localStorage.setItem('celebi_quote_inquiries', JSON.stringify(existing));
        } catch (_) {}

        if (btn) {
          btn.disabled = true;
          btn.textContent = 'İletiliyor...';
        }

        try {
          fetch(`${pbBase}/api/collections/teklif_talepleri/records`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(pbPayload),
            keepalive: true,
          }).catch(() => {});
        } catch (_) {}

        if (typeof window.celebiTrack === 'function') {
          window.celebiTrack('generate_lead', {
            service_type: serviceType,
            method: 'quick_callback',
            landing_page: pbPayload.landingPage,
            utm_source: pbPayload.utmSource || 'direct',
          });
        }

        if (feedback) {
          feedback.className = 'qc-feedback mt-2.5 p-3 rounded-xl text-xs font-semibold bg-emerald-500/20 text-emerald-100 border border-emerald-400/40 block';
          feedback.innerHTML = '✓ Numaranız yönetim uzmanımıza iletildi! En geç 5 dakika içinde dönüş yapıyoruz.';
        }

        form.reset();
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Beni 5 Dakikada Arayın →';
        }
      });
    });
  })();
</script>
