---
import BaseLayout from '@/layouts/BaseLayout.astro';
import QuickCallbackBar from '@/components/sections/QuickCallbackBar.astro';
import { ARTICLES_DATA, type ArticleItem } from '@/lib/articles-data';
import { COMPANY_INFO } from '@/lib/fallback-data';

interface UnifiedArticle {
  slug: string;
  title: string;
  seoTitle?: string;
  category: string;
  tag: string;
  tagColor: string;
  readTime: string;
  publishDate: string;
  isoDate: string;
  summary: string;
  image: string;
  authorName: string;
  authorRole: string;
  keyTakeaways: string[];
  rawHtml?: string;
  content?: ArticleItem['content'];
}

export async function getStaticPaths() {
  const seenSlugs = new Set<string>();
  const unifiedList: UnifiedArticle[] = [];

  const toStaticUnified = (a: ArticleItem): UnifiedArticle => ({
    slug: a.slug,
    title: a.title,
    category: a.category,
    tag: a.tag,
    tagColor: a.tagColor,
    readTime: a.readTime,
    publishDate: a.publishDate,
    isoDate: a.isoDate,
    summary: a.summary,
    image: a.image,
    authorName: a.author.name,
    authorRole: a.author.role,
    keyTakeaways: a.keyTakeaways,
    content: a.content,
  });

  // 1. Live PocketBase articles (pre-rendered as full crawlable static HTML)
  try {
    const res = await fetch('https://celebiyonetim.com.tr/api/collections/yazilar/records?perPage=200', {
      headers: { 'User-Agent': 'Mozilla/5.0' },
      signal: AbortSignal.timeout(6000),
    });
    if (res.ok) {
      const data = await res.json();
      for (const item of data.items || []) {
        const slug = String(item.slug || '').trim();
        if (!slug || seenSlugs.has(slug) || item.aktif === false) continue;
        // Skip slugs with invalid path characters
        if (!/^[a-z0-9-]+$/i.test(slug)) continue;
        seenSlugs.add(slug);

        const rawHtml = String(item.ozet || '').trim();
        const plainSummary =
          String(item.seoDescription || '').trim() ||
          rawHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 180);

        const rawCategory = String(item.kategori || 'Site Yönetimi');
        const catLower = rawCategory.toLocaleLowerCase('tr-TR');
        const isCleaningCat = catLower.includes('temizlik') || catLower.includes('hijyen');
        const isLegalCat = catLower.includes('hukuk') || catLower.includes('mevzuat');

        const tagColor = isCleaningCat
          ? 'bg-emerald-50 text-emerald-800 border-emerald-200'
          : isLegalCat
            ? 'bg-amber-50 text-amber-800 border-amber-200'
            : 'bg-sky-50 text-sky-800 border-sky-200';

        const authorRole = isCleaningCat
          ? 'Kurumsal Temizlik & İş Güvenliği Uzmanı'
          : isLegalCat
            ? 'Kat Mülkiyeti Kanunu (KMK) Mevzuat Uzmanı'
            : 'Kat Mülkiyeti Kanunu ve Tesis Yönetimi Uzmanı';

        const keyTakeaways = isCleaningCat
          ? [
              'SGK Güvenceli, İSG Eğitimli ve Sabit Kadrolu Temizlik Personeli',
              'Adana Çukurova, Seyhan ve Sarıçam İçin Aynı Gün Ücretsiz Keşif & Teklif',
            ]
          : isLegalCat
            ? [
                '634 Sayılı Kat Mülkiyeti Kanunu (KMK) Hükümleri ile Tam Uyumlu Uygulama',
                'Noter, İşletme Projesi ve İcra Takip Süreçlerinde Hukuki Güvence',
              ]
            : [
                '634 Sayılı Kat Mülkiyeti Kanunu (KMK) Mevzuatı ile Tam Uyumlu',
                'Adana Çukurova, Seyhan ve Sarıçam Yerel Yönetim Standartları',
              ];

        unifiedList.push({
          slug,
          title: String(item.baslik || slug),
          seoTitle: String(item.seoTitle || '').trim() || undefined,
          category: rawCategory,
          tag: rawCategory || 'Rehber',
          tagColor,
          readTime: String(item.okumaSuresi || '4 dk okuma'),
          publishDate: String(item.tarih || 'Güncel'),
          isoDate: '2026-11-22',
          summary: plainSummary,
          image: String(
            item.kapakGorsel ||
              'https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=1200&q=80'
          ),
          authorName: String(item.kaynak || 'Çelebi Hukuk & Yönetim Kurulu'),
          authorRole,
          keyTakeaways,
          rawHtml,
        });
      }
    }
  } catch (_) {
    // Fallback to static ARTICLES_DATA
  }

  // 2. Hardcoded fallback/featured articles (deduplicated)
  for (const a of ARTICLES_DATA) {
    if (!a.slug || seenSlugs.has(a.slug)) continue;
    seenSlugs.add(a.slug);
    unifiedList.push(toStaticUnified(a));
  }

  return unifiedList.map((article) => ({
    params: { slug: article.slug },
    props: {
      article,
      relatedArticles: unifiedList.filter((x) => x.slug !== article.slug).slice(0, 3),
    },
  }));
}

interface Props {
  article: UnifiedArticle;
  relatedArticles: UnifiedArticle[];
}

const { article, relatedArticles } = Astro.props;

const siteUrl = 'https://celebiyonetim.com.tr';
const canonicalArticleUrl = `${siteUrl}/yazilar/${article.slug}`;
const pageTitle = article.seoTitle || `${article.title} | Çelebi Yönetim & Temizlik`;
const pageDescription = article.summary;
const shareUrl = `${canonicalArticleUrl}?utm_source=whatsapp_share&utm_medium=referral&utm_campaign=rehber_paylasim`;
const whatsappShareMsg = `Komşular / Yöneticiler merhaba, binamızla ilgili faydalı bir rehber paylaşmak istedim:\n"${article.title}"\n${shareUrl}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.summary,
  image: article.image,
  datePublished: article.isoDate || '2026-11-22',
  dateModified: article.isoDate || '2026-11-22',
  author: {
    '@type': 'Person',
    name: article.authorName,
    jobTitle: article.authorRole,
  },
  publisher: {
    '@type': 'Organization',
    name: COMPANY_INFO.name,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/assets/logo/celebi-logo.svg`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalArticleUrl,
  },
};

const isCleaningArticle = article.category.toLowerCase().includes('temizlik') || article.category.toLowerCase().includes('hijyen');
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonicalArticleUrl} ogType="article">
  <!-- Article Header & Hero -->
  <article class="pt-8 pb-16 sm:pt-14 sm:pb-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6" aria-label="Ekmek Kırıntısı">
        <a href="/" class="hover:text-sky-700 transition-colors">Ana Sayfa</a>
        <span>/</span>
        <a href="/yazilar" class="hover:text-sky-700 transition-colors">Sektörel Yazılar</a>
        <span>/</span>
        <span class="text-slate-900 font-bold truncate max-w-[200px] sm:max-w-xs">{article.category}</span>
      </nav>

      <!-- Category Pill & Read Meta -->
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class={`px-3 py-1 rounded-full text-xs font-bold border ${article.tagColor}`}>
          {article.tag}
        </span>
        <span class="text-xs text-slate-400 font-medium">• {article.readTime}</span>
        <span class="text-xs text-slate-400 font-medium">• {article.publishDate}</span>
      </div>

      <!-- Main Title -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.15] mb-6">
        {article.title}
      </h1>

      <!-- Author Byline -->
      <div class="flex flex-wrap items-center justify-between gap-4 pb-8 border-b border-slate-200">
        <div class="flex items-center gap-3.5">
          <div class="w-11 h-11 rounded-xl bg-white border border-slate-200 p-1 flex items-center justify-center shadow-sm shrink-0">
            <img src="/assets/logo/celebi-logo-mark.svg?v=2" alt="Çelebi Yönetim" width="36" height="36" class="w-full h-full object-contain" />
          </div>
          <div>
            <div class="text-sm font-bold text-slate-900">{article.authorName}</div>
            <div class="text-xs text-slate-500">{article.authorRole} • Çelebi Yönetim</div>
          </div>
        </div>

        <a
          href={`https://wa.me/?text=${encodeURIComponent(whatsappShareMsg)}`}
          target="_blank"
          rel="noopener noreferrer"
          data-skip-wa-track="true"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition-colors"
        >
          <span>Apartman Grubunda Paylaş ↗</span>
        </a>
      </div>

      <!-- Featured Image -->
      <div class="my-8 rounded-3xl overflow-hidden shadow-xl border border-slate-200 max-h-[460px] bg-slate-100">
        <img
          src={article.image}
          alt={article.title}
          width="900"
          height="500"
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <!-- Key Takeaways / Yönetici Özeti Box -->
      <div class="my-10 p-6 sm:p-8 rounded-3xl bg-slate-50 border border-slate-200/90 shadow-sm">
        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-sky-800 mb-3">
          <svg class="w-4 h-4 fill-current text-sky-600" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
          </svg>
          <span>Önemli Başlıklar &amp; Yönetici Özeti</span>
        </div>
        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700">
          {article.keyTakeaways.map((item) => (
            <li class="flex items-start gap-2.5 font-medium">
              <span class="text-emerald-600 font-bold mt-0.5">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Article Rich Content Body -->
      {article.rawHtml ? (
        <div
          class="prose prose-slate max-w-none text-slate-700 leading-relaxed space-y-5 [&>h2]:text-xl [&>h2]:sm:text-2xl [&>h2]:font-bold [&>h2]:text-slate-900 [&>h2]:pt-4 [&>h3]:text-lg [&>h3]:font-bold [&>h3]:text-slate-900 [&>p]:text-sm [&>p]:sm:text-base [&>p]:text-slate-600 [&>p]:leading-relaxed [&>ul]:list-disc [&>ul]:pl-5 [&>ul]:space-y-1.5 [&>ul]:text-sm [&>ul]:text-slate-700"
          set:html={article.rawHtml}
        />
      ) : article.content ? (
        <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed space-y-8">
          <p class="text-base sm:text-lg text-slate-700 font-normal leading-relaxed border-l-4 border-sky-600 pl-4 py-1 italic bg-sky-50/30 rounded-r-xl">
            {article.content.lead}
          </p>

          {article.content.sections.map((section) => (
            <section class="space-y-4">
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight pt-4">
                {section.heading}
              </h2>
              {section.paragraphs.map((p) => (
                <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
                  {p}
                </p>
              ))}
              {section.listItems && section.listItems.length > 0 && (
                <ul class="space-y-2 my-4 pl-2">
                  {section.listItems.map((li) => (
                    <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-700 font-medium">
                      <span class="w-1.5 h-1.5 rounded-full bg-sky-600 mt-2 shrink-0"></span>
                      <span>{li}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))}
        </div>
      ) : null}

      <!-- 5-Min Quick Callback Bar inside Article -->
      <QuickCallbackBar
        compact={true}
        contextLabel={`Makale: ${article.title}`}
        serviceType={isCleaningArticle ? 'Ofis & Ticari Alan Temizliği' : 'Site & Apartman Yönetimi'}
      />

      <!-- High-Converting In-Article Lead Generation Callout -->
      <div class="my-10 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-slate-950 via-slate-900 to-sky-950 text-white shadow-2xl border border-sky-900/60 relative overflow-hidden">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative z-10">
          <div class="space-y-2 max-w-xl">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                Adana Geneli Ücretsiz Keşif
              </span>
              <a href="/site-yonetimi-fiyat-hesapla" class="text-xs text-sky-300 hover:text-white font-bold underline">
                30 Sn. Maliyet Hesapla →
              </a>
            </div>
            <h3 class="text-xl sm:text-2xl font-black text-white leading-tight">
              Apartmanınız veya İş Yeriniz İçin Fiyat Teklifi Alın
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Mevzuata tam uyumlu site yönetimi, aidat tahsilatı veya SGK'lı periyodik temizlik için uzmanımız aynı gün keşif yapsın.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 shrink-0 w-full lg:w-auto">
            <a
              href={`tel:${COMPANY_INFO.phone.replace(/[^0-9+]/g, '')}`}
              class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-6 py-3.5 text-xs sm:text-sm font-black text-slate-950 bg-white hover:bg-sky-50 active:scale-95 rounded-2xl transition-all shadow-lg text-center cursor-pointer"
              title="Çelebi Yönetim Santralini Arayın"
            >
              <span>{COMPANY_INFO.phoneFormatted}</span>
            </a>

            <a
              href={`https://wa.me/${COMPANY_INFO.whatsapp}?text=${encodeURIComponent(`Merhaba Çelebi Yönetim, "${article.title}" yazınızı okudum. Hizmetleriniz için ücretsiz keşif ve fiyat teklifi almak istiyorum.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-6 py-3.5 text-xs sm:text-sm font-black text-white bg-emerald-600 hover:bg-emerald-500 active:scale-95 rounded-2xl transition-all shadow-lg shadow-emerald-900/30 text-center cursor-pointer"
              title="WhatsApp İle Danışın"
            >
              <span>WhatsApp Teklif</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Author Bio Footer Box -->
      <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-white border border-slate-200 p-1.5 flex items-center justify-center shrink-0">
          <img src="/assets/logo/celebi-logo-mark.svg?v=2" alt="Çelebi Yönetim" width="40" height="40" class="w-full h-full object-contain" />
        </div>
        <div>
          <div class="text-sm font-bold text-slate-900">{article.authorName}</div>
          <p class="text-xs text-slate-500 mt-0.5">
            Çelebi Yönetim ve Temizlik bünyesinde kat mülkiyeti mevzuatı, finansal aidat denetimi ve kurumsal temizlik operasyonlarını yürütmektedir.
          </p>
        </div>
      </div>

      <!-- Navigation to all articles -->
      <div class="mt-8 pt-6 border-t border-slate-200 flex items-center justify-between text-xs flex-wrap gap-3">
        <a href="/yazilar" class="inline-flex items-center gap-1.5 font-bold text-sky-700 hover:text-sky-900 transition-colors">
          <span>← Tüm Yazılara Geri Dön</span>
        </a>
        <a href="/site-yonetimi-fiyat-hesapla" class="font-bold text-[#004AAD] hover:underline">
          30 Saniyede Yönetim Maliyeti Hesapla →
        </a>
        <a href="/#iletisim" class="font-bold text-slate-700 hover:text-slate-950 transition-colors">
          Ücretsiz Fiyat Teklifi Al →
        </a>
      </div>

    </div>
  </article>

  <!-- Related Articles Grid -->
  <section class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl mb-10">
        <h3 class="text-2xl font-extrabold text-slate-900 tracking-tight">
          İlginizi Çekebilecek Diğer Rehber Makaleleri
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          Kat mülkiyeti, icra takibi ve endüstriyel hijyen hakkında diğer yazılarımız.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedArticles.map((rel) => (
          <article class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-200 flex flex-col justify-between group">
            <div>
              <div class="relative h-44 overflow-hidden bg-slate-100">
                <img
                  src={rel.image}
                  alt={rel.title}
                  width="400"
                  height="240"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <span class={`absolute top-3 left-3 px-2 py-0.5 rounded-full text-[10px] font-bold border backdrop-blur-md bg-white/95 ${rel.tagColor}`}>
                  {rel.tag}
                </span>
              </div>
              <div class="p-5">
                <div class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider mb-1.5">
                  {rel.publishDate} • {rel.readTime}
                </div>
                <h4 class="text-sm font-bold text-slate-900 group-hover:text-sky-700 transition-colors line-clamp-2 leading-snug mb-2">
                  <a href={`/yazilar/${rel.slug}`}>
                    {rel.title}
                  </a>
                </h4>
                <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                  {rel.summary}
                </p>
              </div>
            </div>
            <div class="p-5 pt-0">
              <a
                href={`/yazilar/${rel.slug}`}
                class="inline-flex items-center gap-1 text-xs font-bold text-sky-700 hover:text-sky-900 transition-colors"
              >
                <span>Yazıyı İncele</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
