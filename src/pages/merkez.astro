    // Notification Settings (PocketBase superuser-protected bildirim_ayarlari + /api/settings SMTP)
    async function ensurePbSuperuserToken(forceRefresh = false) {
      if (!forceRefresh) {
        try {
          const cached = sessionStorage.getItem('celebi_pb_su_token');
          if (cached) return cached;
        } catch (_) {}
      }
      const res = await fetch(`${PB_BASE_URL}/api/collections/_superusers/auth-with-password`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ identity: PRIMARY_ADMIN.email, password: PRIMARY_ADMIN.password }),
      });
      if (!res.ok) throw new Error('PocketBase yönetici oturumu açılamadı (HTTP ' + res.status + ')');
      const data = await res.json();
      if (!data.token) throw new Error('Yönetici token alınamadı');
      try { sessionStorage.setItem('celebi_pb_su_token', data.token); } catch (_) {}
      return data.token;
    }

    async function pbSuperuserFetch(url, options = {}) {
      let token = await ensurePbSuperuserToken(false);
      let res = await fetch(url, {
        ...options,
        headers: { ...(options.headers || {}), Authorization: token },
      });
      if (res.status === 401) {
        token = await ensurePbSuperuserToken(true);
        res = await fetch(url, {
          ...options,
          headers: { ...(options.headers || {}), Authorization: token },
        });
      }
      return res;
    }

    function showNtfAlert(isOk, htmlMsg) {
      if (!ntfAlert) return;
      ntfAlert.className = isOk
        ? 'p-4 rounded-xl text-xs font-bold border bg-emerald-100 text-emerald-900 border-emerald-300 block'
        : 'p-4 rounded-xl text-xs font-bold border bg-amber-50 text-amber-900 border-amber-300 block';
      ntfAlert.innerHTML = htmlMsg;
    }

    function updateSmtpStatusBadge(smtp) {
      if (!ntfSmtpBadge) return;
      const ready = Boolean(smtp && smtp.enabled && smtp.host && smtp.host !== 'smtp.example.com' && smtp.username);
      if (ready) {
        ntfSmtpBadge.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200';
        ntfSmtpBadge.textContent = `✓ SMTP Aktif (${smtp.host})`;
      } else {
        ntfSmtpBadge.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-100 text-amber-800 border border-amber-200';
        ntfSmtpBadge.textContent = '⚠ SMTP Kurulumu Bekleniyor';
      }
    }

    async function loadNotificationSettings() {
      if (!notificationForm) return;
      try {
        const [recRes, setRes] = await Promise.all([
          pbSuperuserFetch(`${PB_BASE_URL}/api/collections/bildirim_ayarlari/records?page=1&perPage=1`),
          pbSuperuserFetch(`${PB_BASE_URL}/api/settings`),
        ]);
        if (recRes.ok) {
          const recData = await recRes.json();
          const item = (recData.items || [])[0];
          if (item) {
            notificationRecordId = item.id;
            if (ntfActive) ntfActive.checked = item.aktif !== false;
            if (ntfEmails) ntfEmails.value = item.aliciMailler || '';
            if (ntfNtfyTopic) ntfNtfyTopic.value = item.ntfyTopic || '';
            if (ntfTgToken) ntfTgToken.value = item.telegramBotToken || '';
            if (ntfTgChatId) ntfTgChatId.value = item.telegramChatId || '';
          }
        }
        if (setRes.ok) {
          const s = await setRes.json();
          const smtp = s?.smtp || {};
          if (ntfSmtpUser) ntfSmtpUser.value = smtp.username || '';
          if (ntfSmtpHost) ntfSmtpHost.value = smtp.host && smtp.host !== 'smtp.example.com' ? smtp.host : '';
          if (ntfSmtpPort) ntfSmtpPort.value = smtp.port ? String(smtp.port) : '587';
          updateSmtpStatusBadge(smtp);
        }
      } catch (err) {
        console.warn('loadNotificationSettings error:', err);
        updateSmtpStatusBadge(null);
      }
    }

    if (ntfPresetGmail) {
      ntfPresetGmail.addEventListener('click', () => {
        if (ntfSmtpHost) ntfSmtpHost.value = 'smtp.gmail.com';
        if (ntfSmtpPort) ntfSmtpPort.value = '587';
        if (ntfGmailTip) ntfGmailTip.classList.remove('hidden');
        if (ntfSmtpUser && !ntfSmtpUser.value && ntfEmails?.value) {
          const firstMail = ntfEmails.value.split(/[,;\s]+/).find((x) => x.includes('@'));
          if (firstMail) ntfSmtpUser.value = firstMail.trim();
        }
      });
    }

    if (ntfPresetCorp) {
      ntfPresetCorp.addEventListener('click', () => {
        if (ntfSmtpHost) ntfSmtpHost.value = 'mail.celebiyonetim.com.tr';
        if (ntfSmtpPort) ntfSmtpPort.value = '587';
        if (ntfGmailTip) ntfGmailTip.classList.add('hidden');
      });
    }

    async function saveNotificationSettings() {
      const cfgPayload = {
        aktif: ntfActive ? ntfActive.checked : true,
        aliciMailler: (ntfEmails?.value || '').trim(),
        ntfyTopic: (ntfNtfyTopic?.value || '').trim(),
        telegramBotToken: (ntfTgToken?.value || '').trim(),
        telegramChatId: (ntfTgChatId?.value || '').trim(),
      };

      const cfgUrl = notificationRecordId
        ? `${PB_BASE_URL}/api/collections/bildirim_ayarlari/records/${notificationRecordId}`
        : `${PB_BASE_URL}/api/collections/bildirim_ayarlari/records`;
      const cfgMethod = notificationRecordId ? 'PATCH' : 'POST';

      const cfgRes = await pbSuperuserFetch(cfgUrl, {
        method: cfgMethod,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(cfgPayload),
      });
      if (!cfgRes.ok) throw new Error('Bildirim alıcıları kaydedilemedi (HTTP ' + cfgRes.status + ')');
      const savedRec = await cfgRes.json();
      if (savedRec.id) notificationRecordId = savedRec.id;

      const smtpHost = (ntfSmtpHost?.value || '').trim();
      const smtpUser = (ntfSmtpUser?.value || '').trim();
      const smtpPort = parseInt(ntfSmtpPort?.value || '587', 10) || 587;
      const smtpPass = (ntfSmtpPass?.value || '').trim();

      if (smtpHost && smtpUser) {
        const smtpPatch = {
          enabled: true,
          host: smtpHost,
          port: smtpPort,
          username: smtpUser,
          tls: smtpPort === 465,
          authMethod: 'PLAIN',
        };
        if (smtpPass) smtpPatch.password = smtpPass;

        const setRes = await pbSuperuserFetch(`${PB_BASE_URL}/api/settings`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            smtp: smtpPatch,
            meta: {
              senderAddress: smtpUser,
              senderName: 'Çelebi Yönetim Web Bildirim',
            },
          }),
        });
        if (!setRes.ok) throw new Error('SMTP ayarları kaydedilemedi (HTTP ' + setRes.status + ')');
        if (ntfSmtpPass) ntfSmtpPass.value = '';
        updateSmtpStatusBadge(smtpPatch);
      }
    }

    if (notificationForm) {
      notificationForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (ntfSaveBtn) {
          ntfSaveBtn.disabled = true;
          ntfSaveBtn.textContent = 'Kaydediliyor...';
        }
        try {
          await saveNotificationSettings();
          showNtfAlert(true, '✓ Bildirim alıcıları ve mail ayarları kaydedildi! Test için "Test Bildirimi Gönder" butonunu kullanabilirsiniz.');
        } catch (err) {
          showNtfAlert(false, '⚠️ Kaydetme hatası: ' + escapeHtml(err.message || err));
        } finally {
          if (ntfSaveBtn) {
            ntfSaveBtn.disabled = false;
            ntfSaveBtn.textContent = '💾 Bildirim Ayarlarını Kaydet';
          }
        }
      });
    }

    if (ntfTestBtn) {
      ntfTestBtn.addEventListener('click', async () => {
        ntfTestBtn.disabled = true;
        ntfTestBtn.textContent = 'Test gönderiliyor...';
        try {
          await saveNotificationSettings();
          const res = await pbSuperuserFetch(`${PB_BASE_URL}/api/celebi/test-notify`, { method: 'POST' });
          if (!res.ok) throw new Error('Test uç noktası HTTP ' + res.status);
          const data = await res.json();
          const lines = [];
          if (data.emailSent) lines.push('✓ Test e-postası gönderildi (gelen kutunuzu ve spam klasörünü kontrol edin).');
          else if (data.emailError) lines.push('• E-posta: ' + escapeHtml(data.emailError));
          if (data.ntfySent) lines.push('✓ ntfy.sh telefon bildirimi gönderildi.');
          else if (data.ntfyError) lines.push('• ntfy.sh: ' + escapeHtml(data.ntfyError));
          if (data.telegramSent) lines.push('✓ Telegram bildirimi gönderildi.');
          else if (data.telegramError) lines.push('• Telegram: ' + escapeHtml(data.telegramError));
          if (!lines.length) lines.push('Herhangi bir bildirim kanalı yapılandırılmamış.');
          const anyOk = Boolean(data.emailSent || data.ntfySent || data.telegramSent);
          showNtfAlert(anyOk, lines.join('<br/>'));
        } catch (err) {
          showNtfAlert(false, '⚠️ Test gönderilemedi: ' + escapeHtml(err.message || err));
        } finally {
          ntfTestBtn.disabled = false;
          ntfTestBtn.textContent = '🧪 Test Bildirimi Gönder';
        }
      });
    }

    // Tracking Settings (PocketBase reklam_ayarlari)
