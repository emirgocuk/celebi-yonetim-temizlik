---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ARTICLES_DATA, type ArticleItem } from '@/lib/articles-data';
import { COMPANY_INFO } from '@/lib/fallback-data';

export function getStaticPaths() {
  return ARTICLES_DATA.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: ArticleItem;
}

const { article } = Astro.props;

// 2 Related articles (excluding current)
const relatedArticles = ARTICLES_DATA.filter((a) => a.slug !== article.slug).slice(0, 3);

const pageTitle = `${article.title} | Çelebi Yönetim & Temizlik`;
const pageDescription = article.summary;

// Schema.org Article Structured Data
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': article.title,
  'description': article.summary,
  'image': article.image,
  'datePublished': article.isoDate,
  'dateModified': article.isoDate,
  'author': {
    '@type': 'Person',
    'name': article.author.name,
    'jobTitle': article.author.role,
  },
  'publisher': {
    '@type': 'Organization',
    'name': COMPANY_INFO.name,
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://www.celebiyonetim.com/assets/images/hero-building.jpg',
    },
  },
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': `https://www.celebiyonetim.com/yazilar/${article.slug}`,
  },
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Article Header & Hero -->
  <article class="pt-8 pb-16 sm:pt-14 sm:pb-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6" aria-label="Ekmek Kırıntısı">
        <a href="/" class="hover:text-sky-700 transition-colors">Ana Sayfa</a>
        <span>/</span>
        <a href="/yazilar" class="hover:text-sky-700 transition-colors">Sektörel Yazılar</a>
        <span>/</span>
        <span class="text-slate-900 font-bold truncate max-w-[200px] sm:max-w-xs">{article.category}</span>
      </nav>

      <!-- Category Pill & Read Meta -->
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class={`px-3 py-1 rounded-full text-xs font-bold border ${article.tagColor}`}>
          {article.tag}
        </span>
        <span class="text-xs text-slate-400 font-medium">• {article.readTime}</span>
        <span class="text-xs text-slate-400 font-medium">• {article.publishDate}</span>
      </div>

      <!-- Main Title -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.15] mb-6">
        {article.title}
      </h1>

      <!-- Author Byline -->
      <div class="flex items-center gap-3.5 pb-8 border-b border-slate-200">
        <div class="w-11 h-11 rounded-full bg-gradient-to-tr from-slate-900 via-slate-800 to-sky-900 text-white flex items-center justify-center font-bold text-sm shadow-sm border border-slate-200">
          Ç
        </div>
        <div>
          <div class="text-sm font-bold text-slate-900">{article.author.name}</div>
          <div class="text-xs text-slate-500">{article.author.role} • Çelebi Yönetim ve Temizlik</div>
        </div>
      </div>

      <!-- Featured Image -->
      <div class="my-8 rounded-3xl overflow-hidden shadow-xl border border-slate-200 max-h-[460px] bg-slate-100">
        <img
          src={article.image}
          alt={article.title}
          width="900"
          height="500"
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <!-- Key Takeaways / Yönetici Özeti Box -->
      <div class="my-10 p-6 sm:p-8 rounded-3xl bg-slate-50 border border-slate-200/90 shadow-sm">
        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-sky-800 mb-3">
          <svg class="w-4 h-4 fill-current text-sky-600" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
          </svg>
          <span>Önemli Başlıklar & Yönetici Özeti</span>
        </div>
        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700">
          {article.keyTakeaways.map((item) => (
            <li class="flex items-start gap-2.5 font-medium">
              <span class="text-emerald-600 font-bold mt-0.5">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Article Rich Content Body -->
      <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed space-y-8">
        
        <!-- Lead text -->
        <p class="text-base sm:text-lg text-slate-700 font-normal leading-relaxed border-l-4 border-sky-600 pl-4 py-1 italic bg-sky-50/30 rounded-r-xl">
          {article.content.lead}
        </p>

        <!-- Sections -->
        {article.content.sections.map((section) => (
          <section class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight pt-4">
              {section.heading}
            </h2>
            {section.paragraphs.map((p) => (
              <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
                {p}
              </p>
            ))}
            {section.listItems && section.listItems.length > 0 && (
              <ul class="space-y-2 my-4 pl-2">
                {section.listItems.map((li) => (
                  <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-700 font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-sky-600 mt-2 shrink-0"></span>
                    <span>{li}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}

      </div>

      <!-- High-Converting In-Article Lead Generation Callout -->
      <div class="my-12 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-slate-950 via-slate-900 to-sky-950 text-white shadow-2xl border border-sky-900/60 relative overflow-hidden">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative z-10">
          <div class="space-y-2 max-w-xl">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                Adana Geneli Ücretsiz Keşif
              </span>
              <span class="text-xs text-sky-400 font-semibold">• Anında Çağrı Desteği</span>
            </div>
            <h3 class="text-xl sm:text-2xl font-black text-white leading-tight">
              Apartmanınız veya İş Yeriniz İçin Fiyat Teklifi Alın
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Mevzuata tam uyumlu site yönetimi, aidat tahsilatı veya SGK'lı periyodik temizlik için uzmanımız aynı gün keşif yapsın.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 shrink-0 w-full lg:w-auto">
            <!-- Hemen Ara Butonu -->
            <a
              href={`tel:${COMPANY_INFO.phone.replace(/[^0-9+]/g, '')}`}
              class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-6 py-3.5 text-xs sm:text-sm font-black text-slate-950 bg-white hover:bg-sky-50 active:scale-95 rounded-2xl transition-all shadow-lg text-center cursor-pointer"
              title="Çelebi Yönetim Santralini Arayın"
            >
              <svg class="w-4 h-4 text-sky-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>{COMPANY_INFO.phone}</span>
            </a>

            <!-- WhatsApp Butonu -->
            <a
              href={`https://wa.me/${COMPANY_INFO.whatsapp}?text=${encodeURIComponent(`Merhaba Çelebi Yönetim, "${article.title}" yazınızı okudum. Hizmetleriniz için ücretsiz keşif ve fiyat teklifi almak istiyorum.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-6 py-3.5 text-xs sm:text-sm font-black text-white bg-emerald-600 hover:bg-emerald-500 active:scale-95 rounded-2xl transition-all shadow-lg shadow-emerald-900/30 text-center cursor-pointer"
              title="WhatsApp İle Danışın"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 2C6.495 2 2 6.492 2 12.029c0 1.956.562 3.864 1.625 5.512L2.008 22l4.613-1.603c1.579.947 3.393 1.45 5.41 1.45 5.536 0 10.031-4.492 10.031-10.029C22.062 6.492 17.567 2 12.031 2zm5.836 14.195c-.244.686-1.42 1.309-1.956 1.392-.516.08-1.188.115-3.834-.979-3.238-1.339-5.321-4.639-5.48-4.854-.16-.214-1.308-1.741-1.308-3.32 0-1.58.825-2.357 1.118-2.678.293-.32.641-.4.855-.4.214 0 .428.002.616.012.2.01.468-.076.732.557.273.655.932 2.274 1.014 2.44.082.165.137.36.027.579-.11.218-.165.355-.328.552-.164.197-.346.438-.493.59-.164.168-.336.352-.145.679.191.327.848 1.398 1.818 2.262 1.248 1.112 2.3 1.456 2.628 1.62.327.164.519.137.71-.082.192-.219.82-1.002 1.039-1.344.219-.343.438-.287.738-.177.301.11 1.912.902 2.24 1.066.328.164.547.246.629.382.082.137.082.795-.162 1.481z" />
              </svg>
              <span>WhatsApp Teklif</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Author Bio Footer Box -->
      <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-base shrink-0">
          Ç
        </div>
        <div>
          <div class="text-sm font-bold text-slate-900">{article.author.name}</div>
          <p class="text-xs text-slate-500 mt-0.5">
            Çelebi Yönetim ve Temizlik bünyesinde kat mülkiyeti mevzuatı, finansal aidat denetimi ve kurumsal temizlik operasyonlarını yürütmektedir.
          </p>
        </div>
      </div>

      <!-- Navigation to all articles -->
      <div class="mt-8 pt-6 border-t border-slate-200 flex items-center justify-between text-xs">
        <a href="/yazilar" class="inline-flex items-center gap-1.5 font-bold text-sky-700 hover:text-sky-900 transition-colors">
          <span>← Tüm Yazılara Geri Dön</span>
        </a>
        <a href="/#iletisim" class="font-bold text-slate-700 hover:text-slate-950 transition-colors">
          Ücretsiz Fiyat Teklifi Al →
        </a>
      </div>

    </div>
  </article>

  <!-- Related Articles Grid -->
  <section class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl mb-10">
        <h3 class="text-2xl font-extrabold text-slate-900 tracking-tight">
          İlginizi Çekebilecek Diğer Rehber Makaleleri
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          Kat mülkiyeti, icra takibi ve endüstriyel hijyen hakkında diğer yazılarımız.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedArticles.map((rel) => (
          <article class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-200 flex flex-col justify-between group">
            <div>
              <div class="relative h-44 overflow-hidden bg-slate-100">
                <img
                  src={rel.image}
                  alt={rel.title}
                  width="400"
                  height="240"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <span class={`absolute top-3 left-3 px-2 py-0.5 rounded-full text-[10px] font-bold border backdrop-blur-md bg-white/95 ${rel.tagColor}`}>
                  {rel.tag}
                </span>
              </div>
              <div class="p-5">
                <div class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider mb-1.5">
                  {rel.publishDate} • {rel.readTime}
                </div>
                <h4 class="text-sm font-bold text-slate-900 group-hover:text-sky-700 transition-colors line-clamp-2 leading-snug mb-2">
                  <a href={`/yazilar/${rel.slug}`}>
                    {rel.title}
                  </a>
                </h4>
                <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                  {rel.summary}
                </p>
              </div>
            </div>
            <div class="p-5 pt-0">
              <a
                href={`/yazilar/${rel.slug}`}
                class="inline-flex items-center gap-1 text-xs font-bold text-sky-700 hover:text-sky-900 transition-colors"
              >
                <span>Yazıyı İncele</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<!-- Inject Article Schema -->
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

