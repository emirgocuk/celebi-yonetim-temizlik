---
import BaseLayout from '@/layouts/BaseLayout.astro';
import QuoteForm from '@/components/sections/QuoteForm.astro';
import { COMPANY_INFO } from '@/lib/fallback-data';

const title = 'İletişim & Konum Bilgileri | Çelebi Yönetim ve Temizlik Adana';
const description = 'Çelebi Yönetim ve Temizlik Adana Çukurova ofis konumu, Google Haritalar yol tarifi, sabit ve mobil hatlar ile 15 dakikada hızlı teklif formu.';
---

<BaseLayout title={title} description={description}>
  <!-- Top Hero & Breadcrumbs -->
  <section class="pt-10 pb-14 sm:pt-16 sm:pb-20 bg-gradient-to-b from-sky-50/60 via-white to-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6" aria-label="Ekmek Kırıntısı">
        <a href="/" class="hover:text-sky-700 transition-colors">Ana Sayfa</a>
        <span>/</span>
        <span class="text-slate-900 font-bold">İletişim & Konum</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-sky-100 text-sky-800 border border-sky-200 mb-4">
          <span>7/24 Kesintisiz Hizmet & Ofis Ziyareti</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight mb-4">
          Bize Ulaşın & Ofisimizi Ziyaret Edin
        </h1>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
          Apartmanınız, siteniz veya ticari işletmeniz için en uygun yönetim modelini ve temizlik planını belirlemek üzere ofisimize bekleriz.
        </p>
      </div>

      <!-- Quick Contact Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mt-10">
        
        <!-- Sabit Ofis Hattı -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200/90 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center font-bold mb-3 shadow-inner">
            <svg class="w-5 h-5 stroke-current stroke-2 fill-none" viewBox="0 0 24 24">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Sabit Ofis Hattı</div>
          <a href={`tel:${COMPANY_INFO.landlinePhone}`} class="text-base font-bold text-slate-900 hover:text-sky-600 transition-colors block">
            {COMPANY_INFO.landlineFormatted}
          </a>
          <p class="text-xs text-slate-500 mt-1">Santral & Genel Danışma</p>
        </div>

        <!-- Temizlik Hizmetleri Hattı -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200/90 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-xl bg-cyan-50 text-cyan-600 flex items-center justify-center font-bold mb-3 shadow-inner">
            <svg class="w-5 h-5 stroke-current stroke-2 fill-none" viewBox="0 0 24 24">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
              <line x1="12" y1="18" x2="12.01" y2="18"/>
            </svg>
          </div>
          <div class="text-xs font-bold text-cyan-700 uppercase tracking-wider mb-1">Temizlik Hizmetleri</div>
          <a href={`tel:${COMPANY_INFO.cleaningPhone}`} class="text-base font-bold text-slate-900 hover:text-cyan-600 transition-colors block">
            {COMPANY_INFO.cleaningPhoneFormatted}
          </a>
          <p class="text-xs text-slate-500 mt-1">Mobil Operasyon Hattı</p>
        </div>

        <!-- Site Yönetimi & WhatsApp -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200/90 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold mb-3 shadow-inner">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.288.043.087.072.188.014.303-.058.116-.087.188-.173.289l-.26.302c-.087.087-.179.182-.077.357.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
            </svg>
          </div>
          <div class="text-xs font-bold text-emerald-700 uppercase tracking-wider mb-1">Yönetim & WhatsApp</div>
          <a
            href={`https://wa.me/${COMPANY_INFO.whatsapp}?text=${encodeURIComponent('Merhaba, Adana site yönetimi ve temizlik hizmetleriniz için bilgi ve teklif almak istiyorum.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-base font-bold text-emerald-800 hover:text-emerald-900 transition-colors block"
          >
            {COMPANY_INFO.managementPhoneFormatted}
          </a>
          <p class="text-xs text-slate-500 mt-1">Anında WhatsApp teklif</p>
        </div>

        <!-- Ofis Adresi & E-Posta -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200/90 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold mb-3 shadow-inner">
            <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
          </div>
          <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Çukurova / Adana</div>
          <div class="text-xs font-bold text-slate-900 leading-snug">Mahfesığmaz Mah. 78033 Sk.</div>
          <p class="text-[11px] text-slate-500 mt-1">No: 3 Zemin Kat, Çukurova</p>
        </div>

      </div>

    </div>
  </section>

  <!-- Google Maps Interactive Location Section -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Left: Address & Directions Card -->
        <div class="lg:col-span-5 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
            <span>Ofis & Genel Merkez</span>
          </div>
          
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight">
            Ofis Konumu ve Yol Tarifi
          </h2>

          <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
            Merkezi konumumuz sayesinde toplu taşıma ve ana arterler üzerinden kolayca ulaşabilir, misafir otoparkımızdan faydalanabilirsiniz.
          </p>

          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-3 text-xs sm:text-sm">
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-lg bg-sky-100 text-sky-700 flex items-center justify-center font-bold shrink-0 mt-0.5">
                📍
              </div>
              <div>
                <strong class="text-slate-900 block font-bold mb-0.5">Açık Adres:</strong>
                <span class="text-slate-600">{COMPANY_INFO.address}</span>
              </div>
            </div>

            <div class="flex items-start gap-3 pt-3 border-t border-slate-200/60">
              <div class="w-6 h-6 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold shrink-0 mt-0.5">
                🚗
              </div>
              <div>
                <strong class="text-slate-900 block font-bold mb-0.5">Otopark ve Ulaşım:</strong>
                <span class="text-slate-600">Binamızın önünde ziyaretçilerimiz için ayrılmış ücretsiz otopark alanı mevcuttur.</span>
              </div>
            </div>
          </div>

          <!-- Open in Google Maps Button -->
          <div>
            <a
              href={`https://maps.google.com/?q=${encodeURIComponent(COMPANY_INFO.address)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3.5 text-xs sm:text-sm font-bold text-white bg-slate-900 hover:bg-sky-700 rounded-2xl shadow-md transition-all duration-150 subtle-tap"
            >
              <svg class="w-4 h-4 fill-current text-white" viewBox="0 0 24 24">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
              <span>Google Haritalar'da Aç & Yol Tarifi Al</span>
              <span>→</span>
            </a>
          </div>

        </div>

        <!-- Right: Interactive Google Maps Iframe Frame -->
        <div class="lg:col-span-7">
          <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-white bg-slate-100 relative h-[420px] sm:h-[480px]">
            <iframe
              title="Çelebi Yönetim ve Temizlik Ofis Konumu"
              src={COMPANY_INFO.mapsEmbedUrl}
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="w-full h-full"
            ></iframe>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Quote Form Section on the Contact Page -->
  <QuoteForm />
</BaseLayout>
