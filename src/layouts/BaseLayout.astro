---
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import SEO from '@/components/seo/SEO.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const { title, description, canonical, ogImage, ogType } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- DNS prefetch for performance -->
    <link rel="dns-prefetch" href="https://wa.me" />
  </head>
  <body class="bg-white text-slate-900 selection:bg-sky-500 selection:text-white flex flex-col min-h-screen">
    <!-- Apple Floating Header -->
    <Header />

    <!-- Main Content Container -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Real-Time Synchronization with /merkez Admin Settings (< 300 bytes) -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('celebi_company_settings');
          if (!saved) return;
          const config = JSON.parse(saved);
          
          if (config.whatsapp) {
            document.querySelectorAll('a[href*="wa.me"]').forEach((a) => {
              const oldHref = a.getAttribute('href') || '';
              const textMatch = oldHref.match(/text=([^&]+)/);
              const textParam = textMatch ? `?text=${textMatch[1]}` : '';
              a.setAttribute('href', `https://wa.me/${config.whatsapp}${textParam}`);
            });
          }
          if (config.phone) {
            document.querySelectorAll('a[href^="tel:"]').forEach((a) => {
              a.setAttribute('href', `tel:${config.phone.replace(/[^0-9+]/g, '')}`);
            });
          }
        } catch (e) {}
      })();
    </script>
  </body>
</html>

