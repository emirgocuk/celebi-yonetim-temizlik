---
import { COMPANY_INFO } from '@/lib/fallback-data';
---

<section id="iletisim" class="scroll-mt-24 py-20 sm:py-28 bg-gradient-to-br from-slate-950 via-slate-900 to-sky-950 text-white relative">
  <div id="teklif-al" class="absolute -top-24" aria-hidden="true"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Copy & Direct Contacts -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-sky-900/60 text-sky-300 border border-sky-700/60 w-fit">
          <span>Şeffaf & Anında Maliyet Analizi</span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight">
          Siteniz veya iş yeriniz için net teklif alın.
        </h2>

        <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
          Formu doldurun, uzman ekibimiz bağımsız bölüm sayısı veya temizlik alanınız için 15 dakika içinde en uygun işletme maliyetini hesaplayıp size ulaşsın.
        </p>

        <div class="pt-4 border-t border-slate-800 flex flex-col gap-3">
          <div class="text-xs text-sky-400 uppercase tracking-wider font-bold">Doğrudan İletişim Kanalları</div>
          
          <a
            href={`tel:${COMPANY_INFO.phone}`}
            class="flex items-center gap-3.5 p-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 transition-colors subtle-tap"
          >
            <div class="w-10 h-10 rounded-xl bg-sky-500/20 text-sky-400 flex items-center justify-center shrink-0 shadow-inner">
              <svg class="w-5 h-5 stroke-current stroke-2 fill-none" viewBox="0 0 24 24">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs text-slate-400">Sabit & Mobil Hat</div>
              <div class="text-sm font-bold text-white">{COMPANY_INFO.phoneFormatted}</div>
            </div>
          </a>

          <a
            href={`https://wa.me/${COMPANY_INFO.whatsapp}?text=${encodeURIComponent('Merhaba, fiyat teklifi almak istiyorum.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3.5 p-4 rounded-2xl bg-emerald-950/40 hover:bg-emerald-950/60 border border-emerald-500/30 transition-colors subtle-tap"
          >
            <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 shadow-inner">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.288.043.087.072.188.014.303-.058.116-.087.188-.173.289l-.26.302c-.087.087-.179.182-.077.357.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs text-emerald-400 font-bold">WhatsApp Hızlı Teklif Hattı</div>
              <div class="text-sm font-bold text-white">Anında Mesaj Gönderin</div>
            </div>
          </a>

          <a
            href="/iletisim"
            class="flex items-center gap-3.5 p-4 rounded-2xl bg-sky-950/40 hover:bg-sky-950/60 border border-sky-500/30 transition-colors subtle-tap"
          >
            <div class="w-10 h-10 rounded-xl bg-sky-500/20 text-sky-400 flex items-center justify-center shrink-0 shadow-inner">
              <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs text-sky-400 font-bold">Ofis Konumu & Yol Tarifi</div>
              <div class="text-sm font-bold text-white">Google Haritalarda Görüntüle →</div>
            </div>
          </a>
        </div>

      </div>

      <!-- Right Column: Clean White Form Card -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-3xl p-7 sm:p-9 text-slate-900 shadow-2xl border border-slate-100">
          <div class="mb-6">
            <h3 class="text-xl font-extrabold text-slate-900">Teklif Talep Formu</h3>
            <p class="text-xs text-slate-500 mt-1">Bilgileriniz KVKK kapsamında korunmakta olup sadece teklif için kullanılır.</p>
          </div>

          <form id="quote-request-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="fullName" class="block text-xs font-bold text-slate-700 mb-1.5">Adınız Soyadınız *</label>
                <input
                  type="text"
                  id="fullName"
                  name="fullName"
                  required
                  placeholder="Ahmet Yılmaz"
                  class="w-full px-4 py-3 text-sm rounded-xl border border-slate-200 focus:border-sky-600 focus:ring-2 focus:ring-sky-100 outline-none transition-all"
                />
              </div>

              <div>
                <label for="phone" class="block text-xs font-bold text-slate-700 mb-1.5">Telefon Numaranız *</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="0555 000 00 00"
                  class="w-full px-4 py-3 text-sm rounded-xl border border-slate-200 focus:border-sky-600 focus:ring-2 focus:ring-sky-100 outline-none transition-all"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="serviceType" class="block text-xs font-bold text-slate-700 mb-1.5">İlgilendiğiniz Hizmet *</label>
                <select
                  id="serviceType"
                  name="serviceType"
                  required
                  class="w-full px-4 py-3 text-sm rounded-xl border border-slate-200 focus:border-sky-600 focus:ring-2 focus:ring-sky-100 outline-none transition-all bg-white font-medium"
                >
                  <option value="site-yonetimi">Site & Apartman Yönetimi</option>
                  <option value="ofis-temizlik">Ofis & Ticari Alan Temizliği</option>
                  <option value="insaat-sonrasi">İnşaat / Tadilat Sonrası Temizlik</option>
                  <option value="dis-cephe">Dış Cephe & Cam Temizliği</option>
                  <option value="merdiven">Apartman Merdiven Temizliği</option>
                </select>
              </div>

              <div>
                <label for="buildingUnits" class="block text-xs font-bold text-slate-700 mb-1.5">Daire / Alan Büyüklüğü (Opsiyonel)</label>
                <input
                  type="text"
                  id="buildingUnits"
                  name="buildingUnits"
                  placeholder="Örn: 32 Daire veya 450 m²"
                  class="w-full px-4 py-3 text-sm rounded-xl border border-slate-200 focus:border-sky-600 focus:ring-2 focus:ring-sky-100 outline-none transition-all"
                />
              </div>
            </div>

            <div>
              <label for="message" class="block text-xs font-bold text-slate-700 mb-1.5">Notunuz veya Özel Talebiniz</label>
              <textarea
                id="message"
                name="message"
                rows="3"
                placeholder="Örneğin: Aidat toplama sorunu yaşıyoruz, genel kurul öncesi işletme projesi teklifi istiyoruz..."
                class="w-full px-4 py-3 text-sm rounded-xl border border-slate-200 focus:border-sky-600 focus:ring-2 focus:ring-sky-100 outline-none transition-all resize-none"
              ></textarea>
            </div>

            <!-- Submit Button & Feedback -->
            <div class="space-y-3">
              <button
                type="submit"
                id="quote-submit-btn"
                class="w-full py-4 px-6 rounded-2xl text-sm sm:text-base font-extrabold text-white bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700 hover:from-emerald-500 hover:to-teal-500 transition-all duration-200 shadow-xl shadow-emerald-700/20 hover:shadow-emerald-700/30 subtle-tap flex items-center justify-center gap-3 cursor-pointer group"
              >
                <!-- Official WhatsApp Icon -->
                <svg class="w-5 h-5 fill-current shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.288.043.087.072.188.014.303-.058.116-.087.188-.173.289l-.26.302c-.087.087-.179.182-.077.357.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
                </svg>
                <span id="btn-text">WhatsApp Üzerinden Gönder</span>
                <span class="text-emerald-200 text-xs font-semibold hidden sm:inline">• Anında Yanıt</span>
              </button>

              <div class="flex items-center justify-center gap-1.5 text-[11px] text-slate-500 text-center">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Talebiniz panele kaydedilir ve doğrudan yetkiliye WhatsApp ile iletilir.</span>
              </div>
            </div>

            <!-- Response Alert Box -->
            <div id="form-alert" class="hidden p-4 rounded-2xl text-xs space-y-2 border"></div>

          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Lightweight script: Form submit -> LocalStorage & PocketBase + Instant WhatsApp Bridge -->
<script is:inline>
  (() => {
    const form = document.getElementById('quote-request-form');
    const alertBox = document.getElementById('form-alert');
    const submitBtn = document.getElementById('quote-submit-btn');

    if (!form || !alertBox || !submitBtn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const fullName = (formData.get('fullName') || '').toString().trim();
      const phone = (formData.get('phone') || '').toString().trim();
      const serviceSelect = document.getElementById('serviceType');
      const serviceLabel = serviceSelect && serviceSelect.options && serviceSelect.selectedIndex >= 0
        ? serviceSelect.options[serviceSelect.selectedIndex].text 
        : (formData.get('serviceType') || 'Site & Apartman Yönetimi');
      const buildingUnits = (formData.get('buildingUnits') || '').toString().trim();
      const message = (formData.get('message') || '').toString().trim();

      if (!fullName || !phone) {
        alertBox.className = 'p-3.5 rounded-xl text-xs font-semibold text-center bg-red-50 text-red-700 border border-red-200 block';
        alertBox.innerText = 'Lütfen adınız soyadınız ve telefon numaranızı eksiksiz giriniz.';
        return;
      }

      // 1. ANINDA PANELE KAYDET (Kullanıcı WhatsApp açıldıktan sonra vazgeçse bile veriler Çelebi Yönetim Merkezinde birikir)
      const now = new Date();
      const dateFormatted = now.toLocaleDateString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric' }) + ' ' + 
                            now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });

      const payload = {
        id: 'talep_' + Date.now(),
        fullName: fullName,
        phone: phone,
        serviceType: serviceLabel,
        buildingUnits: buildingUnits || '-',
        message: message || '',
        created: dateFormatted,
        timestamp: Date.now(),
        status: 'Yeni',
        channel: 'WhatsApp Teklif Formu',
      };

      try {
        const existing = JSON.parse(localStorage.getItem('celebi_quote_inquiries') || '[]');
        existing.unshift(payload);
        localStorage.setItem('celebi_quote_inquiries', JSON.stringify(existing));
      } catch (err) {
        console.warn('LocalStorage kayıt uyarısı:', err);
      }

      // Arka planda PocketBase servisine de asenkron ilet
      try {
        fetch('http://127.0.0.1:8090/api/collections/teklif_talepleri/records', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        }).catch(() => {});
      } catch (_) {}

      // 2. HEDEF WHATSAPP NUMARASINI BELİRLE
      // Admin panelinde (/merkez) güncellenmiş şirket ayarlarından numarayı al veya varsayılanı kullan
      let targetWhatsApp = '905330383188';
      try {
        const customSettings = JSON.parse(localStorage.getItem('celebi_company_settings') || '{}');
        if (customSettings.whatsapp) {
          targetWhatsApp = customSettings.whatsapp.replace(/[^0-9]/g, '');
        }
      } catch (_) {}

      if (!targetWhatsApp.startsWith('90')) {
        targetWhatsApp = '90' + targetWhatsApp.replace(/^0/, '');
      }

      // 3. ŞIK & NET WHATSAPP MESAJ METNİNİ OLUŞTUR
      let waText = `🔔 *YENİ TEKLİF TALEBİ* (Web Sitesi)\n`;
      waText += `━━━━━━━━━━━━━━━━━━━━\n`;
      waText += `👤 *Ad Soyad:* ${fullName}\n`;
      waText += `📱 *Telefon:* ${phone}\n`;
      waText += `🏢 *Hizmet:* ${serviceLabel}\n`;
      if (buildingUnits) {
        waText += `📐 *Birim / Alan:* ${buildingUnits}\n`;
      }
      if (message) {
        waText += `💬 *Müşteri Notu:* ${message}\n`;
      }
      waText += `━━━━━━━━━━━━━━━━━━━━\n`;
      waText += `📅 *Tarih:* ${dateFormatted}\n\n`;
      waText += `Fiyat teklifi ve detaylı bilgilendirme rica ediyorum.`;

      const waUrl = `https://wa.me/${targetWhatsApp}?text=${encodeURIComponent(waText)}`;

      // 4. WHATSAPP'I YENİ SEKMEDE DOĞRUDAN AÇ
      window.open(waUrl, '_blank');

      // 5. BAŞARI BİLDİRİMİNİ & YEDEK BUTONU GÖSTER
      alertBox.className = 'p-4 rounded-2xl text-xs bg-emerald-50 text-emerald-950 border border-emerald-300 block space-y-2.5 shadow-sm';
      alertBox.innerHTML = `
        <div class="flex items-center gap-2 font-bold text-emerald-800 text-sm">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Talebiniz Alındı ve Yönetim Merkezine Kaydedildi!</span>
        </div>
        <p class="text-slate-600 leading-relaxed font-normal">
          WhatsApp teklif pencereniz hazırlandı. Eğer yeni sekmede açılmadıysa aşağıdaki butona dokunarak doğrudan WhatsApp'tan mesajınızı gönderebilirsiniz:
        </p>
        <div class="pt-1">
          <a
            href="${waUrl}"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs transition-colors shadow-sm"
          >
            <!-- WhatsApp Icon -->
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.288.043.087.072.188.014.303-.058.116-.087.188-.173.289l-.26.302c-.087.087-.179.182-.077.357.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
            </svg>
            <span>WhatsApp ile Mesajı Gönder →</span>
          </a>
        </div>
      `;

      // Formu temizle
      form.reset();
    });
  })();
</script>
