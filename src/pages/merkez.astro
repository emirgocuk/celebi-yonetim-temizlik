    if (trackingForm) {
      trackingForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
          ga4Id: (trkGa4Id?.value || '').trim(),
          gadsId: (trkGadsId?.value || '').trim(),
          gadsConvLead: (trkGadsConvLead?.value || '').trim(),
          gadsConvWhatsapp: (trkGadsConvWhatsapp?.value || '').trim(),
          gadsConvCall: (trkGadsConvCall?.value || '').trim(),
          metaPixelId: (trkMetaPixelId?.value || '').trim(),
        };
        try {
          const url = trackingRecordId
            ? `${PB_BASE_URL}/api/collections/reklam_ayarlari/records/${trackingRecordId}`
            : `${PB_BASE_URL}/api/collections/reklam_ayarlari/records`;
          const method = trackingRecordId ? 'PATCH' : 'POST';
          const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!res.ok) throw new Error('HTTP ' + res.status);
          const saved = await res.json();
          if (saved.id) trackingRecordId = saved.id;
          try { sessionStorage.removeItem('celebi_tracking_cfg'); } catch (_) {}
          if (trackingAlert) {
            trackingAlert.classList.remove('hidden');
            setTimeout(() => trackingAlert.classList.add('hidden'), 5000);
          }
        } catch (err) {
          alert('İzleme kodları kaydedilirken hata oluştu: ' + (err.message || err));
