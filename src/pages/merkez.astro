    async function loadTimerSettings() {
      try {
        const res = await fetch(`${PB_BASE_URL}/api/collections/otomatik_yayin_ayarlari/records`);
        if (!res.ok) throw new Error('Timer fetch error');
        const data = await res.json();
        if (data.items && data.items.length > 0) {
          timerData = data.items[0];
          timerRecordId = timerData.id;
          renderTimerUI(timerData);
        }
      } catch (err) {
        console.warn('Timer settings could not be fetched:', err);
      }
      loadQueueStats();
    }

    async function loadQueueStats() {
      try {
        const qRes = await fetch(`${PB_BASE_URL}/api/collections/seo_keywords/records?page=1&perPage=1&filter=used%3Dfalse`);
        if (qRes.ok) {
          const qData = await qRes.json();
          if (timerQueueCount) timerQueueCount.innerText = qData.totalItems ?? 0;
        }
      } catch (e) {}
    }

    function renderTimerUI(data) {
      if (!data) return;

      const isActive = data.aktif === true;
      if (timerToggleActive) timerToggleActive.checked = isActive;
      if (timerStatusText) {
        timerStatusText.innerText = isActive ? 'AÇIK' : 'KAPALI';
        timerStatusText.className = isActive ? 'text-xs font-bold text-emerald-700' : 'text-xs font-bold text-slate-400';
      }
      if (timerLiveBadge) {
        timerLiveBadge.className = isActive
          ? 'px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200 flex items-center gap-1'
          : 'px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-500 border border-slate-200 flex items-center gap-1';
        timerLiveBadge.innerHTML = isActive
          ? '<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Zamanlayıcı Aktif'
          : '<span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> Durduruldu';
      }

      if (timerSelectFrequency && data.siklik) {
        timerSelectFrequency.value = data.siklik;
      }

      if (timerSelectDistrict && data.hedefIlce) {
        timerSelectDistrict.value = data.hedefIlce;
      }

      if (timerTotalCount) timerTotalCount.innerText = data.toplamUretilen ?? 0;
      if (timerLastArticle && data.sonBaslik) {
        timerLastArticle.innerText = `Son Yayın: "${data.sonBaslik}"`;
      }
      if (timerLastRun && data.sonCalisma) {
        timerLastRun.innerText = `Son: ${data.sonCalisma}`;
      }

      updateCountdownDisplay();
    }

    function updateCountdownDisplay() {
      if (!timerData || !timerCountdown) return;
      if (!timerData.aktif) {
        timerCountdown.innerHTML = '<span class="text-xs text-slate-400 font-bold">Durduruldu (Kapalı)</span>';
        return;
      }

      const lastStr = timerData.sonCalisma;
      if (!lastStr) {
        timerCountdown.innerHTML = '<span class="text-xs text-emerald-600 font-bold">İlk çalışma bekleniyor...</span>';
        return;
      }

      const intervals = {
        '1h': 3600,
        '3h': 10800,
        '6h': 21600,
        '12h': 43200,
        '24h': 86400
      };
      const reqSec = intervals[timerData.siklik] || 21600;

      const lastDt = new Date(lastStr.replace(' ', 'T'));
      const nextDt = new Date(lastDt.getTime() + reqSec * 1000);
      const now = new Date();
      const diffSec = Math.floor((nextDt.getTime() - now.getTime()) / 1000);

      if (diffSec <= 0) {
        timerCountdown.innerHTML = '<span class="text-xs text-emerald-600 font-bold animate-pulse">⚡ Sıradaki periyot hazır</span>';
      } else {
        const hours = Math.floor(diffSec / 3600);
        const mins = Math.floor((diffSec % 3600) / 60);
        const secs = diffSec % 60;
        timerCountdown.innerHTML = `<span class="text-sm">⏳</span> <span>${hours > 0 ? hours + 's ' : ''}${mins}dk ${secs}sn</span>`;
      }
    }

    if (timerToggleActive) {
      timerToggleActive.addEventListener('change', () => {
        if (timerStatusText) {
          timerStatusText.innerText = timerToggleActive.checked ? 'AÇIK' : 'KAPALI';
