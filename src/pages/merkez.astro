---
import { COMPANY_INFO } from '@/lib/fallback-data';
import '@/styles/global.css';

const title = 'Yönetim Merkezi | Çelebi Yönetim ve Temizlik';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-slate-100/80 text-slate-900 min-h-screen flex flex-col antialiased selection:bg-slate-900 selection:text-white">
    <div id="merkez-app" class="min-h-screen py-6 sm:py-10">
    
    <!-- AUTH VIEW: Login Screen -->
    <div id="auth-screen" class="max-w-md mx-auto px-4 sm:px-6 pt-12 pb-16">
      <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-2xl border border-slate-200/90 relative overflow-hidden">
        
        <!-- Ambient top sheen -->
        <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-48 h-24 bg-sky-500/20 rounded-full blur-2xl pointer-events-none"></div>

        <div class="flex flex-col items-center text-center mb-8">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-slate-950 via-slate-900 to-sky-900 text-white flex items-center justify-center font-bold text-2xl shadow-lg border border-white/40 mb-4">
            Ç
          </div>
          <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Çelebi Yönetim Merkezi</h1>
          <p class="text-xs text-slate-500 mt-1">İç operasyon, teklif formları ve firma ayarları paneli</p>
        </div>

        <form id="login-form" class="space-y-4">
          <div>
            <label for="admin-email" class="block text-xs font-bold text-slate-700 mb-1.5">Kullanıcı E-Posta</label>
            <input
              type="email"
              id="admin-email"
              required
              autocomplete="username"
              placeholder="ornek@celebiyonetim.com.tr"
              class="w-full px-4 py-3 text-sm rounded-xl border border-slate-200 focus:border-sky-600 focus:ring-2 focus:ring-sky-100 outline-none transition-all"
            />
          </div>

          <div>
            <label for="admin-password" class="block text-xs font-bold text-slate-700 mb-1.5">Şifre</label>
            <input
              type="password"
              id="admin-password"
              required
              autocomplete="current-password"
              placeholder="••••••••"
              class="w-full px-4 py-3 text-sm rounded-xl border border-slate-200 focus:border-sky-600 focus:ring-2 focus:ring-sky-100 outline-none transition-all"
            />
          </div>

          <div id="login-error" class="hidden p-3 rounded-xl bg-red-50 border border-red-200 text-xs font-semibold text-red-700 text-center">
            Hatalı e-posta veya şifre girdiniz! Lütfen kontrol edin.
          </div>

          <button
            type="submit"
            class="w-full py-3.5 px-6 rounded-xl text-sm font-bold text-white bg-slate-900 hover:bg-sky-700 transition-all duration-150 shadow-lg shadow-slate-900/10 subtle-tap cursor-pointer"
          >
            Güvenli Giriş Yap
          </button>

          <div class="pt-4 text-center">
            <a href="/" class="text-xs text-slate-500 hover:text-slate-800 transition-colors inline-flex items-center gap-1">
              <span>←</span>
              <span>Web Sitesine Geri Dön</span>
            </a>
          </div>
        </form>

      </div>
    </div>

    <!-- DASHBOARD VIEW: Authenticated Area -->
    <div id="dashboard-screen" class="hidden max-w-7xl mx-auto px-4 sm:px-6">
      
      <!-- Top Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-5 sm:p-6 rounded-3xl bg-white border border-slate-200 shadow-sm mb-8">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center font-bold text-lg shadow-sm">
            Ç
          </div>
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <h2 class="text-lg font-bold text-slate-900">Yönetim Merkezi</h2>
              <span id="user-badge" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                Oturum Açık: emrggck@gmail.com
              </span>
            </div>
            <p class="text-xs text-slate-500">Çelebi Yönetim ve Temizlik Operasyon & Yetkilendirme Paneli</p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="/"
            target="_blank"
            class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold text-slate-700 hover:text-slate-950 bg-slate-100 hover:bg-slate-200 rounded-xl transition-all"
          >
            <span>Siteyi Görüntüle</span>
            <span>↗</span>
          </a>
          <button
            type="button"
            id="logout-btn"
            class="px-4 py-2 text-xs font-bold text-red-700 hover:text-white bg-red-50 hover:bg-red-600 rounded-xl border border-red-200 transition-all cursor-pointer"
          >
            Çıkış Yap
          </button>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-6 border-b border-slate-200 no-scrollbar">
        <button
          type="button"
          data-tab="inquiries"
          class="tab-btn px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-bold transition-all cursor-pointer bg-slate-900 text-white shadow-sm flex items-center gap-2 shrink-0"
        >
          <span>📬 İletişim Formları & Gelen Talepler</span>
          <span id="tab-inquiries-badge" class="px-1.5 py-0.2 rounded-full text-[10px] bg-sky-400 text-slate-950 font-black">0</span>
        </button>

        <button
          type="button"
          data-tab="settings"
          class="tab-btn px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-bold transition-all cursor-pointer bg-white text-slate-700 border border-slate-200 hover:bg-slate-50 flex items-center gap-2 shrink-0"
        >
          <span>🏢 İletişim & Konum Bilgileri</span>
        </button>

        <button
          type="button"
          data-tab="users-settings"
          class="tab-btn px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-bold transition-all cursor-pointer bg-white text-slate-700 border border-slate-200 hover:bg-slate-50 flex items-center gap-2 shrink-0"
        >
          <span>👥 Kullanıcılar & Sistem Ayarları</span>
        </button>

        <button
          type="button"
          data-tab="ceo-seo"
          class="tab-btn px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-bold transition-all cursor-pointer bg-white text-slate-700 border border-slate-200 hover:bg-slate-50 flex items-center gap-2 shrink-0"
        >
          <span>🚀 CEO & Otomatik Haber Motoru</span>
        </button>
      </div>

      <!-- TAB 1 CONTENT: İletişim Formları -->
      <div id="tab-content-inquiries" class="tab-pane space-y-6">
        
        <!-- Summary Stats Strip -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm">
            <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Toplam Gelen Talep</div>
            <div id="stat-total-inquiries" class="text-2xl font-extrabold text-slate-900 tabular-nums">0</div>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm">
            <div class="text-xs font-bold text-emerald-600 uppercase tracking-wider mb-1">Yeni / Bekleyen Talepler</div>
            <div id="stat-pending-inquiries" class="text-2xl font-extrabold text-emerald-700 tabular-nums">0</div>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm">
            <div class="text-xs font-bold text-sky-600 uppercase tracking-wider mb-1">Hızlı Yanıt Oranı</div>
            <div class="text-2xl font-extrabold text-sky-700 tabular-nums">%100</div>
          </div>
        </div>

        <!-- Inquiries List -->
        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="p-6 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-base font-bold text-slate-900">Gelen Fiyat Teklifi ve İletişim Formları</h3>
              <p class="text-xs text-slate-500 mt-0.5">Sitedeki teklif formu üzerinden iletilen gerçek zamanlı müşteri kayıtları</p>
            </div>
            
            <button
              type="button"
              id="clear-all-inquiries-btn"
              class="text-xs text-red-600 hover:text-red-800 font-semibold cursor-pointer underline"
            >
              Listeyi Temizle
            </button>
          </div>

          <div id="inquiries-list-container" class="divide-y divide-slate-100">
            <!-- Dynamic entries loaded here -->
          </div>
        </div>

      </div>

      <!-- TAB 2 CONTENT: İletişim Bilgilerini Düzenle -->
      <div id="tab-content-settings" class="tab-pane hidden space-y-6">
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
          <div class="max-w-2xl mb-8">
            <h3 class="text-xl font-bold text-slate-900">İletişim & Konum Bilgilerini Düzenle</h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
              Burada güncelleyeceğiniz WhatsApp numarası, telefon, adres ve Google Maps harita bilgisi web sitesinin tamamında anında geçerli olur.
            </p>
          </div>

          <form id="settings-form" class="space-y-6 max-w-3xl">
            
            <!-- WhatsApp Numarası -->
            <div class="p-5 rounded-2xl bg-emerald-50/50 border border-emerald-200">
              <label for="cfg-whatsapp" class="block text-xs font-bold text-emerald-900 mb-1.5">
                WhatsApp Bağlantı Butonuna Yazılacak Numara *
              </label>
              <div class="text-[11px] text-emerald-700 mb-2 font-medium">
                Başında 90 olacak şekilde boşluksuz ve parantezsiz yazınız (Örn: 905358730324). Sitedeki tüm WhatsApp butonları doğrudan bu numaraya bağlanır.
              </div>
              <input
                type="text"
                id="cfg-whatsapp"
                required
                placeholder="905358730324"
                class="w-full px-4 py-3 text-sm rounded-xl border border-emerald-300 bg-white focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100 outline-none font-bold text-slate-900"
              />
            </div>

            <!-- Telefon Bilgisi -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="cfg-phone" class="block text-xs font-bold text-slate-700 mb-1.5">Telefon Numarası (Arama İçin)</label>
                <input
                  type="text"
                  id="cfg-phone"
                  required
                  placeholder="+90 322 235 15 88"
                  class="w-full px-4 py-3 text-sm rounded-xl border border-slate-200 focus:border-sky-600 focus:ring-2 focus:ring-sky-100 outline-none"
                />
              </div>

              <div>
                <label for="cfg-phone-formatted" class="block text-xs font-bold text-slate-700 mb-1.5">Görünen Telefon Formatı</label>
                <input
                  type="text"
                  id="cfg-phone-formatted"
                  required
                  placeholder="0 (322) 235 15 88"
                  class="w-full px-4 py-3 text-sm rounded-xl border border-slate-200 focus:border-sky-600 focus:ring-2 focus:ring-sky-100 outline-none"
                />
              </div>
            </div>

            <!-- E-Posta & Çalışma Saatleri -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="cfg-email" class="block text-xs font-bold text-slate-700 mb-1.5">Resmi E-Posta Adresi</label>
                <input
                  type="email"
                  id="cfg-email"
                  required
                  placeholder="iletisim@celebiyonetim.com.tr"
                  class="w-full px-4 py-3 text-sm rounded-xl border border-slate-200 focus:border-sky-600 focus:ring-2 focus:ring-sky-100 outline-none"
                />
              </div>

              <div>
                <label for="cfg-working-hours" class="block text-xs font-bold text-slate-700 mb-1.5">Çalışma Saatleri Metni</label>
                <input
                  type="text"
                  id="cfg-working-hours"
                  required
                  placeholder="Pazartesi - Cumartesi: 08:30 - 19:00 (Acil Destek: 7/24)"
                  class="w-full px-4 py-3 text-sm rounded-xl border border-slate-200 focus:border-sky-600 focus:ring-2 focus:ring-sky-100 outline-none"
                />
              </div>
            </div>

            <!-- Açık Adres -->
            <div>
              <label for="cfg-address" class="block text-xs font-bold text-slate-700 mb-1.5">Firma Açık Adresi</label>
              <textarea
                id="cfg-address"
                rows="2"
                required
                placeholder="Mahfesığmaz Mah. 78033 Sk. No: 3 Zemin Kat, Çukurova / Adana"
                class="w-full px-4 py-3 text-sm rounded-xl border border-slate-200 focus:border-sky-600 focus:ring-2 focus:ring-sky-100 outline-none resize-none"
              ></textarea>
            </div>

            <!-- Google Maps Konum Embed Bağlantısı -->
            <div class="p-5 rounded-2xl bg-sky-50/50 border border-sky-200">
              <label for="cfg-maps-url" class="block text-xs font-bold text-sky-900 mb-1.5">
                Google Maps Konum Bilgisi (Harita Embed URL) *
              </label>
              <div class="text-[11px] text-sky-700 mb-2 font-medium">
                Google Haritalar'da ofisinizi bulun -> Paylaş -> Harita Yerleştirme (iframe src bağlantısı).
              </div>
              <input
                type="text"
                id="cfg-maps-url"
                required
                placeholder="https://maps.google.com/maps?q=Mahfes%C4%B1%C4%9Fmaz%20Mah.%2078033%20Sk.%20No%203...&output=embed"
                class="w-full px-4 py-3 text-xs sm:text-sm rounded-xl border border-sky-300 bg-white focus:border-sky-600 focus:ring-2 focus:ring-sky-100 outline-none font-mono text-slate-800"
              />

              <!-- Live Map Preview inside Admin -->
              <div class="mt-4 pt-4 border-t border-sky-200">
                <span class="text-xs font-bold text-slate-700 block mb-2">Harita Canlı Önizlemesi:</span>
                <div class="rounded-xl overflow-hidden border border-slate-300 h-48 bg-slate-200">
                  <iframe
                    id="settings-map-preview"
                    src=""
                    width="100%"
                    height="100%"
                    style="border:0;"
                    loading="lazy"
                  ></iframe>
                </div>
              </div>
            </div>

            <!-- Save Feedback Alert -->
            <div id="settings-alert" class="hidden p-4 rounded-xl text-xs font-bold text-center bg-emerald-100 text-emerald-900 border border-emerald-300">
              ✓ Değişiklikler başarıyla kaydedildi! Sitedeki tüm WhatsApp butonları, adres ve harita yeni bilgilerle senkronize edildi.
            </div>

            <!-- Submit -->
            <button
              type="submit"
              class="px-8 py-3.5 text-sm font-bold text-white bg-slate-900 hover:bg-sky-700 rounded-xl transition-all duration-150 subtle-tap shadow-lg cursor-pointer"
            >
              Değişiklikleri Kaydet
            </button>
          </form>
        </div>
      </div>

      <!-- TAB 3 CONTENT: Kullanıcı Tanımlama & Sistem Ayarları -->
      <div id="tab-content-users-settings" class="tab-pane hidden space-y-6">
        
        <!-- Section 1: Kullanıcı Tanımlama (Firma Sahibi & Ekip) -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-6 border-b border-slate-100">
            <div>
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-sky-100 text-sky-800 mb-2">
                👥 Yetkili Kullanıcı Yönetimi
              </div>
              <h3 class="text-xl font-bold text-slate-900">Firma Sahibi & Ekip Hesabı Tanımla</h3>
              <p class="text-xs sm:text-sm text-slate-600 mt-1">
                Firma sahibine veya personelinize bu panele erişmeleri için hesap oluşturabilirsiniz. Oluşturduğunuz kullanıcılar kendi bilgileriyle güvenle giriş yapabilir.
              </p>
            </div>
          </div>

          <!-- New User Form -->
          <form id="new-user-form" class="space-y-4 max-w-2xl bg-slate-50/70 p-5 rounded-2xl border border-slate-200 mb-8">
            <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider">➕ Yeni Kullanıcı Ekle</h4>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="new-user-name" class="block text-xs font-bold text-slate-700 mb-1">Ad Soyad / Ünvan *</label>
                <input
                  type="text"
                  id="new-user-name"
                  required
                  placeholder="Örn: Murat Çelebi (Firma Sahibi)"
                  class="w-full px-4 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-white focus:border-sky-600 focus:ring-2 focus:ring-sky-100 outline-none"
                />
              </div>

              <div>
                <label for="new-user-role" class="block text-xs font-bold text-slate-700 mb-1">Kullanıcı Rolü *</label>
                <select
                  id="new-user-role"
                  class="w-full px-4 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-white focus:border-sky-600 focus:ring-2 focus:ring-sky-100 outline-none font-medium"
                >
                  <option value="Firma Sahibi / Üst Yönetim">Firma Sahibi / Üst Yönetim</option>
                  <option value="Site Yönetim Uzmanı">Site Yönetim Uzmanı</option>
                  <option value="Temizlik Operasyon Şefi">Temizlik Operasyon Şefi</option>
                  <option value="Müşteri Temsilcisi">Müşteri Temsilcisi</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="new-user-email" class="block text-xs font-bold text-slate-700 mb-1">Giriş E-Postası *</label>
                <input
                  type="email"
                  id="new-user-email"
                  required
                  placeholder="sahip@celebiyonetim.com.tr"
                  class="w-full px-4 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-white focus:border-sky-600 focus:ring-2 focus:ring-sky-100 outline-none"
                />
              </div>

              <div>
                <label for="new-user-password" class="block text-xs font-bold text-slate-700 mb-1">Giriş Şifresi *</label>
                <input
                  type="text"
                  id="new-user-password"
                  required
                  placeholder="En az 6 karakterli şifre"
                  class="w-full px-4 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-white focus:border-sky-600 focus:ring-2 focus:ring-sky-100 outline-none font-mono"
                />
              </div>
            </div>

            <div id="new-user-alert" class="hidden p-3 rounded-xl text-xs font-bold bg-emerald-100 text-emerald-900 border border-emerald-300">
              ✓ Kullanıcı başarıyla tanımlandı! Artık bu e-posta ve şifre ile panele giriş yapabilir.
            </div>

            <button
              type="submit"
              class="px-6 py-2.5 text-xs sm:text-sm font-bold text-white bg-slate-900 hover:bg-sky-700 rounded-xl transition-all shadow-sm cursor-pointer"
            >
              Kullanıcıyı Kaydet ve Yetkilendir
            </button>
          </form>

          <!-- Registered Users List -->
          <div>
            <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-3">Mevcut Yetkili Kullanıcılar</h4>
            <div id="users-list-container" class="space-y-3">
              <!-- Rendered via JS -->
            </div>
          </div>
        </div>

        <!-- Section 2: Sistem ve Veritabanı Altyapı Durumu -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 mb-2">
            ⚙️ Sistem & Altyapı Durumu
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Sunucu & Veritabanı Entegrasyonu</h3>
          <p class="text-xs sm:text-sm text-slate-600 mb-6">
            Sitenin arkasında çalışan Ubuntu 22.04 LTS VDS sunucusu, PocketBase veritabanı ve Cloudflare güvenlik katmanı.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200">
              <div class="text-[11px] font-bold text-slate-500 uppercase">Sunucu IP (VDS)</div>
              <div class="text-sm font-mono font-bold text-slate-900 mt-1">2.27.101.128</div>
              <div class="text-[10px] text-emerald-700 font-semibold mt-1 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Nginx + 2 GB Swap Aktif
              </div>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200">
              <div class="text-[11px] font-bold text-slate-500 uppercase">PocketBase Veritabanı</div>
              <div class="text-sm font-mono font-bold text-slate-900 mt-1">v0.41.1 (Systemd)</div>
              <div class="text-[10px] text-emerald-700 font-semibold mt-1 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> 7/24 Arka Planda Aktif (10 MB RAM)
              </div>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200">
              <div class="text-[11px] font-bold text-slate-500 uppercase">Güvenlik & SSL</div>
              <div class="text-sm font-mono font-bold text-slate-900 mt-1">Cloudflare Full SSL</div>
              <div class="text-[10px] text-sky-700 font-semibold mt-1 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-sky-500"></span> DDoS & CDN Korumalı
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- TAB 4 CONTENT: CEO & Otomatik Haber Oluşturucu (SEO) -->
      <div id="tab-content-ceo-seo" class="tab-pane hidden space-y-6">
        
        <!-- Welcome & Future Ready Notice -->
        <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-br from-slate-950 via-slate-900 to-sky-950 text-white shadow-xl relative overflow-hidden">
          <div class="max-w-2xl">
            <span class="inline-flex px-3 py-1 rounded-full text-xs font-bold bg-sky-500/20 text-sky-300 border border-sky-400/30 mb-3">
              CEO & Otomasyon Modülü
            </span>
            <h3 class="text-2xl sm:text-3xl font-extrabold mb-3">Otomatik Haber Oluşturucu & SEO Motoru</h3>
