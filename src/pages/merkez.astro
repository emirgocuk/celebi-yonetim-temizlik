          if (!res.ok) throw new Error('Kaydedilemedi');
          timerData = await res.json();
          renderTimerUI(timerData);
          alert('✓ Otomatik yayın zamanlayıcı ayarları başarıyla güncellendi!');
        } catch (err) {
          alert('Ayarlar kaydedilirken hata oluştu: ' + err.message);
