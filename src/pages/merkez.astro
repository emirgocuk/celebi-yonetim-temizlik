        const apiKey = getActiveImgbbKey();
        if (!apiKey) {
          alert('ImageBB API anahtarı bulunamadı! Lütfen projenizdeki .env dosyasına IMGBB_API_KEY ekleyin veya sağdaki kutucuktan girin.');
          return;
        }

        // Magic Bytes Validation
        const buffer = await file.arrayBuffer();
        const b = new Uint8Array(buffer.slice(0, 4));
        const isJpg = b[0] === 0xFF && b[1] === 0xD8 && b[2] === 0xFF;
        const isPng = b[0] === 0x89 && b[1] === 0x50 && b[2] === 0x4E && b[3] === 0x47;
        const isWebp = b[0] === 0x52 && b[1] === 0x49 && b[2] === 0x46 && b[3] === 0x46;

        if (!isJpg && !isPng && !isWebp) {
          alert('Güvenlik Uyarısı: Sadece gerçek JPG, PNG veya WEBP görsel dosyaları yüklenebilir!');
          return;
        }

        ceBtnUploadImage.disabled = true;
        ceBtnUploadImage.innerText = 'Yükleniyor...';

        try {
          const formData = new FormData();
          formData.append('image', file);

          const res = await fetch(`https://api.imgbb.com/1/upload?key=${apiKey}`, {
            method: 'POST',
            body: formData
          });

          if (!res.ok) throw new Error('ImageBB yükleme başarısız!');
          const data = await res.json();
          const cdnUrl = data?.data?.url;

          if (cdnUrl) {
            if (ceCoverImage) ceCoverImage.value = cdnUrl;
            if (ceBodyHtml) {
              ceBodyHtml.value = `<img src="${cdnUrl}" alt="${ceTitle ? ceTitle.value : 'Görsel'}" class="my-6 rounded-2xl w-full object-cover max-h-96" />\n` + ceBodyHtml.value;
              runQualityGateCheck();
            }
            alert('✓ Görsel ImageBB CDN sunucularına başarıyla yüklendi ve makaleye eklendi!');
          }
        } catch (err) {
          alert('Görsel yüklenirken hata: ' + err.message);
        } finally {
          ceBtnUploadImage.disabled = false;
          ceBtnUploadImage.innerText = 'Yükle';
        }
      });
    }

    // Reset Editor Mode (Clear Editing State)
    function resetEditorMode() {
      currentEditingArticleId = null;
      if (ceEditBanner) ceEditBanner.classList.add('hidden');
      if (ceBtnSavePb) ceBtnSavePb.innerText = "💾 PocketBase'e Yayınla 🚀";
      if (ceBtnSaveDraft) ceBtnSaveDraft.innerText = '📝 Taslak Olarak Kaydet';
    }

    // Start Editing an Existing Article
    function startEditArticle(art) {
      currentEditingArticleId = art.id;
      if (ceTitle) ceTitle.value = art.baslik || '';
      if (ceSlug) ceSlug.value = art.slug || '';
      if (ceCategory) ceCategory.value = art.kategori || 'Site Yönetimi';
      if (ceReadTime) ceReadTime.value = art.okumaSuresi || '4 dk okuma';
      if (ceCoverImage) ceCoverImage.value = art.kapakGorsel || '';
      if (ceSeoTitle) ceSeoTitle.value = art.seoTitle || '';
      if (ceSeoDesc) ceSeoDesc.value = art.seoDescription || '';
      if (ceBodyHtml) ceBodyHtml.value = art.ozet || '';

      if (ceEditBanner) {
        ceEditBanner.innerHTML = `
          <div class="flex items-center gap-2">
            <span class="text-lg">✏️</span>
            <div>
              <div class="font-extrabold text-amber-950">Makale Düzenleniyor: "${art.baslik}"</div>
              <div class="text-[10px] text-amber-700">Veritabanı ID: ${art.id} • Slug: /yazilar/${art.slug}</div>
            </div>
          </div>
          <button type="button" id="btn-cancel-edit" class="px-3 py-1.5 rounded-xl bg-amber-200 hover:bg-amber-300 text-amber-900 font-bold text-xs transition cursor-pointer shrink-0">
            ✕ Düzenlemeyi İptal Et
          </button>
        `;
        ceEditBanner.classList.remove('hidden');
        document.getElementById('btn-cancel-edit')?.addEventListener('click', () => {
          resetEditorMode();
          if (ceTitle) ceTitle.value = '';
          if (ceSlug) ceSlug.value = '';
          if (ceBodyHtml) ceBodyHtml.value = '';
          runQualityGateCheck();
        });
      }

      if (ceBtnSavePb) ceBtnSavePb.innerText = '💾 Değişiklikleri Güncelle & Yayınla 🚀';
      if (ceBtnSaveDraft) ceBtnSaveDraft.innerText = '📝 Taslak Olarak Güncelle';

      if (ceEditorWrapper) {
        ceEditorWrapper.classList.remove('hidden');
        ceEditorWrapper.scrollIntoView({ behavior: 'smooth' });
      }

      runQualityGateCheck();
    }

    // Save Article to PocketBase (Create or Update)
    async function saveArticle(aktif = true) {
      if (!ceTitle || !ceBodyHtml || !ceSlug) return;
      const title = ceTitle.value.trim();
      const body = ceBodyHtml.value.trim();
      const slug = ceSlug.value.trim();

      if (!title || !body || !slug) {
        alert('Lütfen başlık, slug ve makale gövdesini eksiksiz doldurun!');
        return;
      }

      if (ceBtnSavePb) ceBtnSavePb.disabled = true;
      if (ceBtnSaveDraft) ceBtnSaveDraft.disabled = true;

      try {
        const payload = {
          baslik: title,
          slug: slug,
          ozet: body,
          kategori: ceCategory ? ceCategory.value : 'Site Yönetimi',
          kategoriRenk: 'blue',
          tarih: new Date().toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }),
          okumaSuresi: ceReadTime ? ceReadTime.value : '4 dk okuma',
          aktif: aktif,
          seoTitle: ceSeoTitle ? ceSeoTitle.value : title,
          seoDescription: ceSeoDesc ? ceSeoDesc.value : title,
          kapakGorsel: ceCoverImage ? ceCoverImage.value : '',
          kaynak: 'Çelebi Yönetim & Temizlik Otomasyon Masası',
          views: 0
        };

        let res;
        if (currentEditingArticleId) {
          res = await fetch(`${PB_BASE_URL}/api/collections/yazilar/records/${currentEditingArticleId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        } else {
          res = await fetch(`${PB_BASE_URL}/api/collections/yazilar/records`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        }

        if (!res.ok) {
          const errData = await res.json();
          throw new Error(JSON.stringify(errData));
        }

        const saved = await res.json();

        // Mark keyword as used if came from select and creating new
        if (!currentEditingArticleId) {
          const selectedOpt = ceKeywordSelect?.selectedOptions?.[0];
          const kwId = selectedOpt?.getAttribute('data-id');
          if (kwId) {
            try {
              await fetch(`${PB_BASE_URL}/api/collections/seo_keywords/records/${kwId}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ used: true, lastGenerated: new Date().toISOString() })
              });
              loadCeKeywords();
            } catch (e) {}
          }
        }

        if (cePublishAlert) {
          cePublishAlert.innerHTML = currentEditingArticleId
            ? `✓ Makale başarıyla güncellendi! ID: <strong>${saved.id}</strong> | Durum: <strong>${aktif ? 'Yayında 🚀' : 'Taslak 📝'}</strong>`
            : `✓ Makale başarıyla PocketBase veritabanına kaydedildi! ID: <strong>${saved.id}</strong> | Durum: <strong>${aktif ? 'Yayında 🚀' : 'Taslak 📝'}</strong>`;
          cePublishAlert.classList.remove('hidden');
          setTimeout(() => cePublishAlert.classList.add('hidden'), 7000);
        }

        resetEditorMode();
        loadCeArticles();

      } catch (err) {
        alert('PocketBase kayıt hatası: ' + err.message);
      } finally {
        if (ceBtnSavePb) ceBtnSavePb.disabled = false;
        if (ceBtnSaveDraft) ceBtnSaveDraft.disabled = false;
      }
    }

    if (ceBtnSavePb) {
      ceBtnSavePb.addEventListener('click', () => saveArticle(true));
    }
    if (ceBtnSaveDraft) {
      ceBtnSaveDraft.addEventListener('click', () => saveArticle(false));
    }

    // Load Articles from PocketBase (Sorted by newest first via sort=-id)
    async function loadCeArticles() {
      if (!ceArticlesList) return;
      try {
        const res = await fetch(`${PB_BASE_URL}/api/collections/yazilar/records?page=1&perPage=50&sort=-id`);
        if (!res.ok) throw new Error('PB articles fetch error: HTTP ' + res.status);
        const data = await res.json();

        if (!data.items || data.items.length === 0) {
          ceArticlesList.innerHTML = `
            <div class="p-8 text-center text-slate-400 text-xs">
              Henüz PocketBase'de yayınlanmış bir makale bulunmuyor. Yukarıdaki panelden ilk SEO makalenizi tek tıkla üretebilirsiniz!
            </div>
          `;
          return;
        }

        ceArticlesList.innerHTML = data.items.map((art) => `
          <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-slate-50/80 transition-colors p-3 rounded-2xl border-b border-slate-100 last:border-b-0">
            <div class="space-y-1 max-w-2xl">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-bold text-sm text-slate-900">${art.baslik}</span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${art.aktif ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' : 'bg-amber-100 text-amber-800 border border-amber-200'}">
                  ${art.aktif ? 'Yayında' : 'Taslak'}
                </span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-sky-50 text-sky-800 border border-sky-200">
                  ${art.kategori || 'Genel'}
                </span>
                <span class="text-[10px] text-slate-400">• ${art.tarih || 'Yeni'}</span>
              </div>
              <div class="text-xs text-slate-500 font-mono truncate">
                Slug: /yazilar/${art.slug}
              </div>
            </div>

            <div class="flex items-center gap-2 shrink-0 flex-wrap">
              <a
                href="/yazilar/oku?slug=${art.slug}"
                target="_blank"
                class="px-3 py-1.5 text-xs font-bold text-sky-700 bg-sky-50 hover:bg-sky-100 border border-sky-200 rounded-xl transition-all"
              >
                Görüntüle ↗
              </a>
              <button
                type="button"
                data-action="edit-art"
                data-id="${art.id}"
                class="px-3 py-1.5 text-xs font-bold text-amber-800 bg-amber-50 hover:bg-amber-100 border border-amber-300 rounded-xl transition-all cursor-pointer flex items-center gap-1 shadow-xs"
              >
                <span>✏️</span>
                <span>Düzenle</span>
              </button>
              <button
                type="button"
                data-action="toggle-art-status"
                data-id="${art.id}"
                data-status="${art.aktif}"
                class="px-3 py-1.5 text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl border border-slate-200 transition-all cursor-pointer"
              >
                ${art.aktif ? 'Taslağa Al' : 'Yayınla'}
              </button>
              <button
                type="button"
                data-action="delete-art"
                data-id="${art.id}"
                class="p-1.5 text-slate-400 hover:text-red-600 rounded-lg transition-colors cursor-pointer"
                title="Sil"
              >
                ✕
              </button>
            </div>
          </div>
        `).join('');

        // Bind Edit buttons
        ceArticlesList.querySelectorAll('[data-action="edit-art"]').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const art = data.items.find(x => x.id === id);
            if (art) startEditArticle(art);
          });
        });

        // Bind article actions (toggle status)
        ceArticlesList.querySelectorAll('[data-action="toggle-art-status"]').forEach(btn => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            const currentStatus = btn.getAttribute('data-status') === 'true';
            try {
              await fetch(`${PB_BASE_URL}/api/collections/yazilar/records/${id}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ aktif: !currentStatus })
              });
              loadCeArticles();
            } catch (e) {
              alert('Durum güncellenirken hata oluştu.');
            }
          });
        });

        // Bind delete buttons
        ceArticlesList.querySelectorAll('[data-action="delete-art"]').forEach(btn => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            if (confirm('Bu makaleyi PocketBase veritabanından kalıcı olarak silmek istediğinize emin misiniz?')) {
              try {
                await fetch(`${PB_BASE_URL}/api/collections/yazilar/records/${id}`, {
                  method: 'DELETE'
                });
                loadCeArticles();
              } catch (e) {
                alert('Silinirken hata oluştu.');
              }
            }
          });
        });

      } catch (err) {
        if (ceArticlesList) {
          ceArticlesList.innerHTML = `
            <div class="p-6 text-center text-slate-400 text-xs">
              PocketBase bağlantısı bekleniyor (${PB_BASE_URL}).
            </div>
          `;
        }
      }
    }

    if (ceBtnRefreshArticles) {
      ceBtnRefreshArticles.addEventListener('click', () => {
        loadCeArticles();
      });
    }

    // Initial check
    checkAuth();
  })();
</script>
  </body>
</html>
