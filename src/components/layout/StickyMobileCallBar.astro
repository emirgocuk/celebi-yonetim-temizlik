---
import { COMPANY_INFO } from '@/lib/fallback-data';

const phoneTel = COMPANY_INFO.phone.replace(/[^0-9+]/g, '');
const whatsappNumber = COMPANY_INFO.whatsapp.replace(/[^0-9]/g, '');
const whatsappPreMsg = encodeURIComponent(
  'Merhaba Çelebi Yönetim, web sitenizden ulaşıyorum. Apartman/site yönetimi ve temizlik hizmetleriniz için ücretsiz keşif ve fiyat teklifi almak istiyorum.'
);
---

<!-- =================================================================== -->
<!-- DYNAMIC FLOATING CONTACT BUTTONS                                    -->
<!-- Mobil: Alt ortada saydam damlacık kapsülü (yazılı)                  -->
<!-- Masaüstü: Sağ altta üst üste 2 adet tam YUVARLAK damla buton (yazısız)-->
<!-- =================================================================== -->
<aside
  id="floating-droplet-bar"
  aria-label="Hızlı İletişim Butonları"
  class="fixed z-50 pointer-events-none select-none bottom-5 inset-x-0 flex justify-center px-4 md:inset-x-auto md:bottom-8 md:right-8 md:flex-col md:items-end md:gap-3.5 md:px-0"
>
  <div
    class="pointer-events-auto flex items-center gap-2 p-1.5 rounded-full backdrop-blur-2xl bg-white/75 border border-white/80 shadow-[0_16px_40px_rgba(15,23,42,0.18),inset_0_1px_2px_rgba(255,255,255,0.95)] ring-1 ring-slate-900/5 transition-all duration-300 md:bg-transparent md:backdrop-blur-none md:border-0 md:shadow-none md:ring-0 md:p-0 md:flex-col md:gap-3.5"
  >
    <!-- 1. Telefon Arama Butonu (Masaüstünde Yuvarlak Damlacık) -->
    <a
      href={`tel:${phoneTel}`}
      id="droplet-call-btn"
      class="group relative flex items-center justify-center gap-2 py-2.5 px-4 sm:px-5 rounded-full bg-gradient-to-r from-sky-500 via-sky-600 to-blue-700 text-white font-black text-xs sm:text-sm shadow-[0_6px_20px_rgba(2,132,199,0.42),inset_0_1px_1px_rgba(255,255,255,0.5)] border border-sky-300/40 active:scale-95 hover:scale-105 md:hover:scale-110 transition-all duration-300 cursor-pointer overflow-hidden md:w-14 md:h-14 md:p-0 md:shadow-[0_10px_25px_rgba(2,132,199,0.48),inset_0_2px_3px_rgba(255,255,255,0.6)]"
      title="Çelebi Yönetim Santrali: 0 (322) 235 15 88"
      aria-label="Telefonla Arayın: 0 (322) 235 15 88"
    >
      <!-- Sıvı Damla Yansıma Işığı (Specular Reflection) -->
      <span class="absolute inset-0 w-full h-full bg-gradient-to-b from-white/35 via-transparent to-transparent pointer-events-none rounded-full"></span>

      <!-- Canlı Nabız Sinyali (Mobilde inline, Masaüstünde sağ üst rozet) -->
      <span class="relative flex h-2.5 w-2.5 shrink-0 md:absolute md:top-1.5 md:right-1.5 md:h-3 md:w-3">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-85"></span>
        <span class="relative inline-flex rounded-full h-full w-full bg-white shadow-sm"></span>
      </span>

      <!-- Telefon İkonu (Masaüstünde 24px tam merkezli) -->
      <svg class="w-4 h-4 md:w-6 md:h-6 shrink-0 text-white transition-transform duration-200 group-hover:rotate-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      
      <!-- Mobil Yazı (Masaüstünde tamamen gizli, sadece yuvarlak buton) -->
      <span class="tracking-wide md:hidden">Hemen Ara</span>

      <!-- Masaüstü Hover Tooltip (Yalnızca fare üzerine gelince solda zarifçe belirir) -->
      <span class="hidden md:group-hover:flex absolute right-16 px-3 py-1.5 rounded-xl bg-slate-900/90 text-white text-xs font-semibold whitespace-nowrap shadow-xl backdrop-blur-md pointer-events-none border border-slate-700/60 items-center gap-1.5 transition-opacity duration-200">
        <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
        Hemen Ara: {COMPANY_INFO.landlineFormatted}
      </span>
    </a>

    <!-- 2. WhatsApp Butonu (Masaüstünde Yuvarlak Damlacık) -->
    <a
      href={`https://wa.me/${whatsappNumber}?text=${whatsappPreMsg}`}
      target="_blank"
      rel="noopener noreferrer"
      id="droplet-wa-btn"
      class="group relative flex items-center justify-center gap-2 py-2.5 px-4 sm:px-5 rounded-full bg-gradient-to-r from-emerald-500 via-emerald-600 to-green-700 text-white font-black text-xs sm:text-sm shadow-[0_6px_20px_rgba(16,185,129,0.42),inset_0_1px_1px_rgba(255,255,255,0.5)] border border-emerald-300/40 active:scale-95 hover:scale-105 md:hover:scale-110 transition-all duration-300 cursor-pointer overflow-hidden md:w-14 md:h-14 md:p-0 md:shadow-[0_10px_25px_rgba(16,185,129,0.48),inset_0_2px_3px_rgba(255,255,255,0.6)]"
      title="WhatsApp Destek Hattı"
      aria-label="WhatsApp Destek Hattı"
    >
      <!-- Sıvı Damla Yansıma Işığı (Specular Reflection) -->
      <span class="absolute inset-0 w-full h-full bg-gradient-to-b from-white/35 via-transparent to-transparent pointer-events-none rounded-full"></span>

      <!-- WhatsApp İkonu (Masaüstünde 24px tam merkezli) -->
      <svg class="w-4 h-4 md:w-6 md:h-6 shrink-0 text-white transition-transform duration-200 group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12.031 2C6.495 2 2 6.492 2 12.029c0 1.956.562 3.864 1.625 5.512L2.008 22l4.613-1.603c1.579.947 3.393 1.45 5.41 1.45 5.536 0 10.031-4.492 10.031-10.029C22.062 6.492 17.567 2 12.031 2zm5.836 14.195c-.244.686-1.42 1.309-1.956 1.392-.516.08-1.188.115-3.834-.979-3.238-1.339-5.321-4.639-5.48-4.854-.16-.214-1.308-1.741-1.308-3.32 0-1.58.825-2.357 1.118-2.678.293-.32.641-.4.855-.4.214 0 .428.002.616.012.2.01.468-.076.732.557.273.655.932 2.274 1.014 2.44.082.165.137.36.027.579-.11.218-.165.355-.328.552-.164.197-.346.438-.493.59-.164.168-.336.352-.145.679.191.327.848 1.398 1.818 2.262 1.248 1.112 2.3 1.456 2.628 1.62.327.164.519.137.71-.082.192-.219.82-1.002 1.039-1.344.219-.343.438-.287.738-.177.301.11 1.912.902 2.24 1.066.328.164.547.246.629.382.082.137.082.795-.162 1.481z" />
      </svg>
      
      <!-- Mobil Yazı (Masaüstünde tamamen gizli, sadece yuvarlak buton) -->
      <span class="tracking-wide md:hidden">WhatsApp</span>

      <!-- Masaüstü Hover Tooltip (Yalnızca fare üzerine gelince solda zarifçe belirir) -->
      <span class="hidden md:group-hover:flex absolute right-16 px-3 py-1.5 rounded-xl bg-slate-900/90 text-white text-xs font-semibold whitespace-nowrap shadow-xl backdrop-blur-md pointer-events-none border border-slate-700/60 items-center gap-1.5 transition-opacity duration-200">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        WhatsApp Teklif Hattı
      </span>
    </a>
  </div>
</aside>
