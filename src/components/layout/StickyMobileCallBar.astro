---
import { COMPANY_INFO } from '@/lib/fallback-data';

const phoneTel = COMPANY_INFO.phone.replace(/[^0-9+]/g, '');
const whatsappNumber = COMPANY_INFO.whatsapp.replace(/[^0-9]/g, '');
const whatsappPreMsg = encodeURIComponent(
  'Merhaba Çelebi Yönetim, web sitenizden ulaşıyorum. Apartman/site yönetimi ve temizlik hizmetleriniz için ücretsiz keşif ve fiyat teklifi almak istiyorum.'
);
---

<!-- =================================================================== -->
<!-- 1. MOBILE BOTTOM STICKY BAR (Ekranın Altında Sabit - Mobil İçin) -->
<!-- =================================================================== -->
<aside
  id="sticky-mobile-call-bar"
  aria-label="Hızlı İletişim ve Arama Menüsü"
  class="fixed bottom-0 inset-x-0 z-50 sm:hidden bg-white/95 backdrop-blur-xl border-t border-slate-200/90 shadow-[0_-8px_32px_rgba(15,23,42,0.14)] px-3 py-2.5 pb-[max(0.625rem,env(safe-area-inset-bottom))] transition-transform duration-300"
>
  <div class="grid grid-cols-2 gap-2.5 max-w-md mx-auto">
    <!-- Hemen Ara Butonu -->
    <a
      href={`tel:${phoneTel}`}
      id="sticky-call-btn"
      class="flex items-center justify-center gap-2 py-3 px-3 rounded-2xl bg-gradient-to-r from-sky-600 via-sky-700 to-blue-800 text-white font-bold text-xs shadow-md shadow-sky-900/20 active:scale-98 transition-transform cursor-pointer"
      title="Çelebi Yönetim ve Temizlik Santralini Arayın"
    >
      <span class="relative flex h-3 w-3 shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-white"></span>
      </span>
      <svg class="w-4 h-4 shrink-0 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span class="truncate tracking-wide font-extrabold">Hemen Ara</span>
    </a>

    <!-- WhatsApp Teklif Butonu -->
    <a
      href={`https://wa.me/${whatsappNumber}?text=${whatsappPreMsg}`}
      target="_blank"
      rel="noopener noreferrer"
      id="sticky-wa-btn"
      class="flex items-center justify-center gap-2 py-3 px-3 rounded-2xl bg-gradient-to-r from-emerald-500 via-emerald-600 to-green-700 text-white font-bold text-xs shadow-md shadow-emerald-900/20 active:scale-98 transition-transform cursor-pointer"
      title="WhatsApp Üzerinden Hızlı Fiyat Alın"
    >
      <svg class="w-4 h-4 shrink-0 text-white" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12.031 2C6.495 2 2 6.492 2 12.029c0 1.956.562 3.864 1.625 5.512L2.008 22l4.613-1.603c1.579.947 3.393 1.45 5.41 1.45 5.536 0 10.031-4.492 10.031-10.029C22.062 6.492 17.567 2 12.031 2zm5.836 14.195c-.244.686-1.42 1.309-1.956 1.392-.516.08-1.188.115-3.834-.979-3.238-1.339-5.321-4.639-5.48-4.854-.16-.214-1.308-1.741-1.308-3.32 0-1.58.825-2.357 1.118-2.678.293-.32.641-.4.855-.4.214 0 .428.002.616.012.2.01.468-.076.732.557.273.655.932 2.274 1.014 2.44.082.165.137.36.027.579-.11.218-.165.355-.328.552-.164.197-.346.438-.493.59-.164.168-.336.352-.145.679.191.327.848 1.398 1.818 2.262 1.248 1.112 2.3 1.456 2.628 1.62.327.164.519.137.71-.082.192-.219.82-1.002 1.039-1.344.219-.343.438-.287.738-.177.301.11 1.912.902 2.24 1.066.328.164.547.246.629.382.082.137.082.795-.162 1.481z" />
      </svg>
      <span class="truncate tracking-wide font-extrabold">WhatsApp Teklif</span>
    </a>
  </div>
</aside>

<!-- =================================================================== -->
<!-- 2. DESKTOP FLOATING CALL PILL (Masaüstü Sağ Alt Sabit Çağrı Kartı) -->
<!-- =================================================================== -->
<aside
  id="floating-desktop-call-card"
  aria-label="Adana İçi Hızlı İletişim Kartı"
  class="hidden sm:flex fixed bottom-6 right-6 z-40 items-center gap-3 bg-white/95 backdrop-blur-xl border border-slate-200/90 rounded-full shadow-[0_12px_40px_rgba(15,23,42,0.16)] p-2 pl-4 transition-all hover:scale-102 hover:shadow-[0_16px_48px_rgba(15,23,42,0.2)]"
>
  <div class="flex items-center gap-2">
    <span class="relative flex h-2.5 w-2.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
    </span>
    <div class="flex flex-col text-left leading-tight">
      <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Adana Ücretsiz Keşif</span>
      <a
        href={`tel:${phoneTel}`}
        class="text-xs font-black text-slate-900 hover:text-sky-700 transition-colors font-mono"
        title="Santrali Arayın"
      >
        {COMPANY_INFO.phone}
      </a>
    </div>
  </div>

  <div class="flex items-center gap-1.5 ml-1">
    <!-- Hızlı Ara Butonu -->
    <a
      href={`tel:${phoneTel}`}
      class="w-9 h-9 rounded-full bg-sky-600 hover:bg-sky-700 text-white flex items-center justify-center shadow-xs transition-transform active:scale-95"
      title="Hemen Ara"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
    </a>

    <!-- WhatsApp Butonu -->
    <a
      href={`https://wa.me/${whatsappNumber}?text=${whatsappPreMsg}`}
      target="_blank"
      rel="noopener noreferrer"
      class="w-9 h-9 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white flex items-center justify-center shadow-xs transition-transform active:scale-95"
      title="WhatsApp'tan Yazın"
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12.031 2C6.495 2 2 6.492 2 12.029c0 1.956.562 3.864 1.625 5.512L2.008 22l4.613-1.603c1.579.947 3.393 1.45 5.41 1.45 5.536 0 10.031-4.492 10.031-10.029C22.062 6.492 17.567 2 12.031 2zm5.836 14.195c-.244.686-1.42 1.309-1.956 1.392-.516.08-1.188.115-3.834-.979-3.238-1.339-5.321-4.639-5.48-4.854-.16-.214-1.308-1.741-1.308-3.32 0-1.58.825-2.357 1.118-2.678.293-.32.641-.4.855-.4.214 0 .428.002.616.012.2.01.468-.076.732.557.273.655.932 2.274 1.014 2.44.082.165.137.36.027.579-.11.218-.165.355-.328.552-.164.197-.346.438-.493.59-.164.168-.336.352-.145.679.191.327.848 1.398 1.818 2.262 1.248 1.112 2.3 1.456 2.628 1.62.327.164.519.137.71-.082.192-.219.82-1.002 1.039-1.344.219-.343.438-.287.738-.177.301.11 1.912.902 2.24 1.066.328.164.547.246.629.382.082.137.082.795-.162 1.481z" />
      </svg>
    </a>
  </div>
</aside>
