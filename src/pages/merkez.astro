          const index = parseInt(btn.getAttribute('data-index'), 10);
          const current = inquiries[index].status || 'Yeni';
          const next = current === 'Yeni' ? 'İncelendi' : current === 'İncelendi' ? 'Teklif Verildi' : 'Yeni';
          inquiries[index].status = next;
          localStorage.setItem('celebi_quote_inquiries', JSON.stringify(inquiries));
          loadInquiries();
        });
      });

      inquiriesContainer.querySelectorAll('[data-action="delete"]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const index = parseInt(btn.getAttribute('data-index'), 10);
          if (confirm('Bu teklif kaydını silmek istediğinize emin misiniz?')) {
            inquiries.splice(index, 1);
            localStorage.setItem('celebi_quote_inquiries', JSON.stringify(inquiries));
            loadInquiries();
          }
        });
      });
    }

    // Clear all inquiries
    if (clearInquiriesBtn) {
      clearInquiriesBtn.addEventListener('click', () => {
        if (confirm('Tüm teklif kayıtlarını temizlemek istediğinize emin misiniz?')) {
          localStorage.setItem('celebi_quote_inquiries', JSON.stringify([]));
          loadInquiries();
        }
      });
    }

    // AI Simulation test button
    const simAiBtn = document.getElementById('btn-simulate-ai');
    const simAiOutput = document.getElementById('ai-sim-output');
    if (simAiBtn && simAiOutput) {
      simAiBtn.addEventListener('click', () => {
        simAiBtn.disabled = true;
        simAiBtn.innerText = 'Makale Üretiliyor...';
        setTimeout(() => {
          simAiOutput.classList.remove('hidden');
          simAiBtn.disabled = false;
          simAiBtn.innerText = 'Otomatik Haber Taslağı Üret ⚡';
        }, 800);
      });
    }

    // Initial check
    checkAuth();
  })();
</script>
  </body>
</html>
