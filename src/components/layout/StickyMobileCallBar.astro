---
import { COMPANY_INFO } from '@/lib/fallback-data';

const phoneTel = COMPANY_INFO.phone.replace(/[^0-9+]/g, '');
const whatsappNumber = COMPANY_INFO.whatsapp.replace(/[^0-9]/g, '');
const whatsappPreMsg = encodeURIComponent(
  'Merhaba Çelebi Yönetim, web sitenizden ulaşıyorum. Apartman/site yönetimi ve temizlik hizmetleriniz için ücretsiz keşif ve fiyat teklifi almak istiyorum.'
);
---

<!-- =================================================================== -->
<!-- DYNAMIC FLOATING GLASS DROPLET (Saydam Sıvı Damlacık Arama Kapsülü) -->
<!-- Arkasında dikdörtgen şerit bulunmaz; saydam cam damlası olarak yüzer -->
<!-- =================================================================== -->
<aside
  id="floating-droplet-bar"
  aria-label="Hızlı Arama ve WhatsApp Damlacığı"
  class="fixed bottom-5 sm:bottom-6 inset-x-0 z-50 flex items-center justify-center pointer-events-none px-4 select-none"
>
  <div
    class="pointer-events-auto flex items-center gap-2 p-1.5 rounded-full backdrop-blur-2xl bg-white/75 border border-white/80 shadow-[0_16px_40px_rgba(15,23,42,0.18),inset_0_1px_2px_rgba(255,255,255,0.95)] ring-1 ring-slate-900/5 transition-all duration-300 hover:scale-102 hover:bg-white/85 hover:shadow-[0_20px_50px_rgba(15,23,42,0.22)]"
  >
    <!-- 1. Telefon Arama Damlası (Su damlası efekti & canlı nabız) -->
    <a
      href={`tel:${phoneTel}`}
      id="droplet-call-btn"
      class="group relative flex items-center gap-2 py-2.5 px-4 sm:px-5 rounded-full bg-gradient-to-r from-sky-500/90 via-sky-600/90 to-blue-700/90 text-white font-black text-xs sm:text-sm shadow-[0_4px_18px_rgba(2,132,199,0.38),inset_0_1px_1px_rgba(255,255,255,0.45)] border border-sky-300/40 active:scale-95 transition-all duration-200 cursor-pointer overflow-hidden"
      title="Çelebi Yönetim ve Temizlik Santralini Arayın"
    >
      <!-- Sıvı Damla Yansıma Işığı (Specular Reflection) -->
      <span class="absolute inset-0 w-full h-full bg-gradient-to-b from-white/30 via-transparent to-transparent pointer-events-none rounded-full"></span>

      <!-- Canlı Nabız Sinyali -->
      <span class="relative flex h-2.5 w-2.5 shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-80"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-white"></span>
      </span>

      <svg class="w-4 h-4 shrink-0 text-white transition-transform duration-200 group-hover:rotate-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span class="tracking-wide">Hemen Ara</span>
    </a>

    <!-- 2. WhatsApp Damlası (Saydam zümrüt cam & teklif çağrısı) -->
    <a
      href={`https://wa.me/${whatsappNumber}?text=${whatsappPreMsg}`}
      target="_blank"
      rel="noopener noreferrer"
      id="droplet-wa-btn"
      class="group relative flex items-center gap-2 py-2.5 px-4 sm:px-5 rounded-full bg-gradient-to-r from-emerald-500/90 via-emerald-600/90 to-green-700/90 text-white font-black text-xs sm:text-sm shadow-[0_4px_18px_rgba(16,185,129,0.38),inset_0_1px_1px_rgba(255,255,255,0.45)] border border-emerald-300/40 active:scale-95 transition-all duration-200 cursor-pointer overflow-hidden"
      title="WhatsApp Üzerinden Hızlı Fiyat Alın"
    >
      <!-- Sıvı Damla Yansıma Işığı (Specular Reflection) -->
      <span class="absolute inset-0 w-full h-full bg-gradient-to-b from-white/30 via-transparent to-transparent pointer-events-none rounded-full"></span>

      <svg class="w-4 h-4 shrink-0 text-white transition-transform duration-200 group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12.031 2C6.495 2 2 6.492 2 12.029c0 1.956.562 3.864 1.625 5.512L2.008 22l4.613-1.603c1.579.947 3.393 1.45 5.41 1.45 5.536 0 10.031-4.492 10.031-10.029C22.062 6.492 17.567 2 12.031 2zm5.836 14.195c-.244.686-1.42 1.309-1.956 1.392-.516.08-1.188.115-3.834-.979-3.238-1.339-5.321-4.639-5.48-4.854-.16-.214-1.308-1.741-1.308-3.32 0-1.58.825-2.357 1.118-2.678.293-.32.641-.4.855-.4.214 0 .428.002.616.012.2.01.468-.076.732.557.273.655.932 2.274 1.014 2.44.082.165.137.36.027.579-.11.218-.165.355-.328.552-.164.197-.346.438-.493.59-.164.168-.336.352-.145.679.191.327.848 1.398 1.818 2.262 1.248 1.112 2.3 1.456 2.628 1.62.327.164.519.137.71-.082.192-.219.82-1.002 1.039-1.344.219-.343.438-.287.738-.177.301.11 1.912.902 2.24 1.066.328.164.547.246.629.382.082.137.082.795-.162 1.481z" />
      </svg>
      <span class="tracking-wide">WhatsApp</span>
    </a>
  </div>
</aside>
