        trackingRecordId = item.id;
        if (trkGa4Id) trkGa4Id.value = item.ga4Id || '';
        if (trkGadsId) trkGadsId.value = item.gadsId || '';
        if (trkGadsConvLead) trkGadsConvLead.value = item.gadsConvLead || '';
        if (trkGadsConvWhatsapp) trkGadsConvWhatsapp.value = item.gadsConvWhatsapp || '';
        if (trkGadsConvCall) trkGadsConvCall.value = item.gadsConvCall || '';
        if (trkMetaPixelId) trkMetaPixelId.value = item.metaPixelId || '';
      } catch (err) {
        console.warn('loadTrackingSettings error:', err);
