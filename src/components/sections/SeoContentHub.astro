---
import { ARTICLES_DATA } from '@/lib/articles-data';

// Top articles displayed on the homepage
const featuredArticles = ARTICLES_DATA;
---

<section id="yazilar" class="scroll-mt-24 py-20 sm:py-28 bg-gradient-to-b from-white via-slate-50 to-white border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    
    <!-- Section Heading with "Tüm Yazıları Oku" CTA -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-14">
      <div class="lg:col-span-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-sky-50 text-sky-800 border border-sky-200 mb-3">
          <span>Sektörel Rehber & Makaleler</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
          Site Yönetimi ve Profesyonel Temizlikte Yasal & Teknik Rehber
        </h2>
        <p class="text-base text-slate-600 leading-relaxed font-normal">
          Kat Mülkiyeti Kanunu (KMK) mevzuatı, aidat tahsilat protokolleri, iş sağlığı güvenliği (İSG) standartları ve kurumsal temizlik metotları hakkında aradığınız tüm yasal ve pratik bilgiler.
        </p>
      </div>

      <!-- "Tüm Yazıları Oku" Action Button -->
      <div class="lg:col-span-4 flex lg:justify-end">
        <a
          href="/yazilar"
          class="inline-flex items-center gap-2 px-6 py-3.5 text-xs sm:text-sm font-bold text-white bg-slate-900 hover:bg-sky-700 rounded-2xl shadow-md transition-all duration-150 subtle-tap"
        >
          <span>Tüm Yazıları Oku</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- Structured Topic Articles with Rich Authority & Direct Read Links -->
    <div class="space-y-6 text-slate-700">
      {featuredArticles.map((article) => (
        <article class="rounded-3xl bg-white border border-slate-200 p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-200 group">
          <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <div class="flex items-center gap-2.5">
              <span class={`px-2.5 py-1 rounded-md text-[11px] font-bold border ${article.tagColor}`}>
                {article.tag}
              </span>
              <span class="text-xs text-slate-400">• {article.readTime}</span>
            </div>
            <span class="text-xs text-slate-400 font-medium">{article.publishDate}</span>
          </div>

          <h3 class="text-xl sm:text-2xl font-bold text-slate-900 mb-3 group-hover:text-sky-700 transition-colors">
            <a href={`/yazilar/${article.slug}`}>
              {article.title}
            </a>
          </h3>

          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6 font-normal">
            {article.summary}
          </p>

          <!-- Quick Takeaways Pills -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-2 mb-6">
            {article.keyTakeaways.slice(0, 2).map((takeaway) => (
              <div class="flex items-start gap-2 p-2.5 rounded-xl bg-slate-50 border border-slate-100 text-[11px] sm:text-xs text-slate-700">
                <span class="text-emerald-600 font-bold shrink-0">✓</span>
                <span class="line-clamp-2">{takeaway}</span>
              </div>
            ))}
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs text-slate-500 font-medium">Yazar: {article.author.name}</span>
            <a
              href={`/yazilar/${article.slug}`}
              class="inline-flex items-center gap-1.5 text-xs font-bold text-sky-700 hover:text-sky-900 transition-colors"
            >
              <span>Yazının Devamını Oku</span>
              <span>→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom Read All Bar -->
    <div class="mt-12 p-6 sm:p-8 rounded-3xl bg-slate-900 text-white flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl">
      <div>
        <h4 class="text-base sm:text-lg font-bold mb-1">Daha Fazla Hukuki ve Teknik Yazı mı Arıyorsunuz?</h4>
        <p class="text-xs sm:text-sm text-slate-300">Tüm makale, yönetmelik özeti ve sektörel rehberlerimizi inceleyin.</p>
      </div>
      <a
        href="/yazilar"
        class="shrink-0 px-6 py-3 text-xs sm:text-sm font-bold text-slate-900 bg-white hover:bg-sky-100 rounded-xl transition-all duration-150 subtle-tap shadow-md"
      >
        Tüm Yazıları Oku →
      </a>
    </div>

    <!-- Keyword & Service Area Tags Strip for Search Clustering -->
    <div class="mt-12 pt-8 border-t border-slate-200 text-xs text-slate-500">
      <div class="font-bold text-slate-800 uppercase tracking-wider mb-3">Popüler Arama Konuları ve Hizmet Bölgeleri</div>
      <div class="flex flex-wrap gap-2">
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">Site Yönetimi Şirketleri</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">Apartman Aidat Takip Sistemi</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">Kat Mülkiyeti Kanunu Danışmanlık</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">Kurumsal Ofis Temizliği</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">İnşaat Sonrası Daire Temizliği</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">Dış Cephe Cam Yıkama Vinçli</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">Haftalık Merdiven Temizliği Sözleşmesi</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">Asansör Periyodik Bakım Takibi</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">İşletme Projesi Hazırlama</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">Rezidans ve Plaza Tesis Yönetimi</span>
      </div>
    </div>

  </div>
</section>
