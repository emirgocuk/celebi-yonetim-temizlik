---
import { COMPANY_INFO } from '@/lib/fallback-data';
---

<section class="scroll-mt-24 relative overflow-hidden pt-8 pb-16 sm:pt-14 sm:pb-24">
  <!-- Fresh Ambient Crystal Glows (Airy, colorful yet lightweight) -->
  <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 w-[55rem] h-[32rem] bg-gradient-to-tr from-sky-200/40 via-cyan-100/30 to-emerald-100/30 blur-3xl -z-10" aria-hidden="true"></div>
  <div class="pointer-events-none absolute top-48 -right-32 w-80 h-80 bg-sky-200/30 rounded-full blur-3xl -z-10" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Live Status Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-white/90 text-sky-900 border border-sky-200/80 mb-6 shadow-sm shadow-sky-100">
          <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>KMK Mevzuatına %100 Uyumlu Yönetim & SGK'lı Temizlik Ekibi</span>
        </div>

        <!-- Main H1 Heading -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.08] mb-6">
          Toplu yaşam alanlarında <span class="text-sky-600 underline decoration-sky-300 decoration-wavy decoration-2 underline-offset-4">şeffaf yönetim</span>, ferah ve denetimli temizlik.
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-8 max-w-2xl font-normal">
          Kat Mülkiyeti Kanunu uyarınca aidat takibini online kasa şeffaflığıyla yönetiyor; siteler, plazalar ve inşaat projeleri için sigortalı uzman kadromuzla A+ hijyen sağlıyoruz.
        </p>

        <!-- Direct Actions -->
        <div class="flex flex-wrap items-center gap-3 sm:gap-4 w-full sm:w-auto mb-10">
          <a
            href="#iletisim"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 text-sm font-bold text-white bg-slate-900 hover:bg-sky-700 rounded-2xl shadow-lg shadow-slate-900/10 transition-all duration-200 subtle-tap"
          >
            <span>Fiyat Teklifi İsteyin</span>
            <svg class="w-4 h-4 stroke-current stroke-2 fill-none" viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>

          <a
            href={`https://wa.me/${COMPANY_INFO.whatsapp}?text=${encodeURIComponent('Merhaba, sitemiz/apartmanımız için bilgi ve fiyat teklifi almak istiyoruz.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 text-sm font-bold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-300/80 rounded-2xl shadow-sm transition-all duration-200 subtle-tap"
          >
            <svg class="w-4 h-4 fill-current text-emerald-600" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.288.043.087.072.188.014.303-.058.116-.087.188-.173.289l-.26.302c-.087.087-.179.182-.077.357.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
            </svg>
            <span>WhatsApp ile Danışın</span>
          </a>
        </div>

        <!-- Trust Badges with Color Accents -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 w-full pt-6 border-t border-slate-200/80 text-xs">
          <div class="flex items-center gap-2.5 p-3 rounded-xl bg-white/70 border border-slate-200/80 shadow-sm">
            <div class="w-7 h-7 rounded-lg bg-sky-100 text-sky-700 flex items-center justify-center shrink-0 font-bold">
              KMK
            </div>
            <div>
              <div class="font-bold text-slate-900">Yasal Mevzuat</div>
              <div class="text-slate-500 text-[11px]">Hukuki ve icra takibi</div>
            </div>
          </div>

          <div class="flex items-center gap-2.5 p-3 rounded-xl bg-white/70 border border-slate-200/80 shadow-sm">
            <div class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 font-bold">
              SGK
            </div>
            <div>
              <div class="font-bold text-slate-900">Sigortalı Kadro</div>
              <div class="text-slate-500 text-[11px]">Eğitimli & denetimli</div>
            </div>
          </div>

          <div class="flex items-center gap-2.5 p-3 rounded-xl bg-white/70 border border-slate-200/80 shadow-sm">
            <div class="w-7 h-7 rounded-lg bg-cyan-100 text-cyan-700 flex items-center justify-center shrink-0 font-bold">
              24/7
            </div>
            <div>
              <div class="font-bold text-slate-900">Teknik Acil Hat</div>
              <div class="text-slate-500 text-[11px]">Asansör & hidrofor</div>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Showcase with Modern Architecture Image & Water Droplet Floating Cards -->
      <div class="lg:col-span-5 relative">
        
        <!-- Main Hero Image Frame -->
        <div class="relative mx-auto rounded-3xl overflow-hidden shadow-2xl border-4 border-white/80 group">
          <img
            src="/assets/images/hero-building.jpg"
            alt="Çelebi Tesis ve Site Yönetimi Modern Yaşam Alanları"
            width="800"
            height="600"
            class="w-full h-[400px] object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/20 to-transparent"></div>
          
          <div class="absolute bottom-5 inset-x-5 text-white">
            <div class="text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1">Modern Tesis ve Site Standartları</div>
            <div class="text-lg font-bold">Toplu Yaşamda Sıfır İhtilaf, Şeffaf Muhasebe</div>
          </div>
        </div>

        <!-- Floating Water-Droplet Stat Badge 1 (Top Left) -->
        <div class="absolute -top-4 -left-4 sm:-left-6 p-4 rounded-2xl water-droplet-glass shadow-xl animate-float max-w-[210px]">
          <div class="flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-xl bg-emerald-500 text-white flex items-center justify-center shadow-md shrink-0">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </div>
            <div>
              <div class="text-base font-extrabold text-slate-900 tabular-nums leading-tight">%98.4</div>
              <div class="text-[11px] font-semibold text-emerald-800">Zamanında Aidat</div>
            </div>
          </div>
        </div>

        <!-- Floating Water-Droplet Stat Badge 2 (Bottom Right) -->
        <div class="absolute -bottom-5 -right-3 sm:-right-5 p-4 rounded-2xl water-droplet-glass shadow-xl animate-float-delayed max-w-[230px]">
          <div class="flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-xl bg-sky-600 text-white flex items-center justify-center shadow-md shrink-0">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <div>
              <div class="text-sm font-bold text-slate-900 leading-tight">A+ Hijyen Denetimi</div>
              <div class="text-[11px] font-medium text-slate-600">Her hafta imzalı kontrol</div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
