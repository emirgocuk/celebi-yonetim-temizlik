    // Smart Stock Image Matcher
    function getMatchedStockImage(topic, category = '') {
      const t = (topic + ' ' + category).toLowerCase();
      let pool = STOCK_IMAGES.site_yonetimi || [];

      if (/aidat|icra|kanun|kmk|hukuk|dava|borç|muhasebe|bütçe|avukat|ihtar/.test(t)) {
        pool = STOCK_IMAGES.hukuk_icra || pool;
      } else if (/dış cephe|cam temiz|vinç|kompozit|yüksek bina/.test(t)) {
        pool = STOCK_IMAGES.dis_cephe || pool;
      } else if (/inşaat|tadilat|şantiye|harç|boya|moloz|teslim temiz/.test(t)) {
        pool = STOCK_IMAGES.insaat_temizlik || pool;
      } else if (/ofis|kurumsal|plaza|şirket|iş yeri|büro/.test(t)) {
        pool = STOCK_IMAGES.kurumsal_temizlik || pool;
      } else if (/merdiven|asansör|hol|apartman temizli|giriş/.test(t)) {
        pool = STOCK_IMAGES.merdiven_temizlik || pool;
      }

      if (!pool || pool.length === 0) return null;
      let hash = 0;
      for (let i = 0; i < topic.length; i++) {
        hash = (hash << 5) - hash + topic.charCodeAt(i);
        hash |= 0;
      }
      const idx = Math.abs(hash) % pool.length;
      return pool[idx];
    }

