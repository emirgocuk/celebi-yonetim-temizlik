                }
              } catch (llmErr) {
                console.warn(`LLM model ${candidate.model} failed, trying next:`, llmErr);
              }
            }
          }

          // Smart royalty-free cover image matching based on topic & category
          const matchedImg = getMatchedStockImage(topic, autoCat);
          const autoCoverUrl = matchedImg ? matchedImg.url : 'https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=1200&q=80';

          // Populate Editor
          if (ceTitle) ceTitle.value = generatedTitle;
          if (ceSlug) ceSlug.value = generatedSlug;
          if (ceCategory) ceCategory.value = autoCat;
          if (ceReadTime) ceReadTime.value = '4 dk okuma';
          if (ceCoverImage) {
            ceCoverImage.value = autoCoverUrl;
            updateCoverPreview(autoCoverUrl);
          }
          if (ceSeoTitle) ceSeoTitle.value = `${generatedTitle.slice(0, 55)} | Çelebi`;
          if (ceSeoDesc) {
            ceSeoDesc.value = isCleaning
              ? `${generatedTitle}: SGK güvenceli ekip, hijyen standartları ve şeffaf fiyatlandırma rehberi.`
              : `${generatedTitle} konusunda Kat Mülkiyeti Kanunu, şeffaf bütçe ve uygulama rehberi.`;
          }
          if (ceBodyHtml) ceBodyHtml.value = bodyHtml.trim();

          if (ceEditorWrapper) {
            ceEditorWrapper.classList.remove('hidden');
            ceEditorWrapper.scrollIntoView({ behavior: 'smooth' });
          }

          runQualityGateCheck();

        } catch (err) {
          alert('Makale üretilirken bir hata oluştu: ' + err.message);
        } finally {
          ceBtnGenerate.disabled = false;
          if (ceBtnGenerateText) ceBtnGenerateText.innerText = 'Tek Tıkla SEO Makalesi Üret ⚡';
        }
      });
    }

    // ImageBB Upload with Magic Bytes & 5MB Limit
    if (ceBtnUploadImage && ceImageFile) {
      ceBtnUploadImage.addEventListener('click', async () => {
        const file = ceImageFile.files?.[0];
        if (!file) {
          alert('Lütfen önce bir görsel dosyası seçin!');
          return;
        }

        if (file.size > 5 * 1024 * 1024) {
          alert('Dosya boyutu 5 MB sınırını aşıyor!');
          return;
        }

        const apiKey = getActiveImgbbKey();
        if (!apiKey) {
          alert('ImageBB API anahtarı bulunamadı! Lütfen projenizdeki .env dosyasına IMGBB_API_KEY ekleyin veya sağdaki kutucuktan girin.');
          return;
        }

        // Magic Bytes Validation
        const buffer = await file.arrayBuffer();
        const b = new Uint8Array(buffer.slice(0, 4));
        const isJpg = b[0] === 0xFF && b[1] === 0xD8 && b[2] === 0xFF;
        const isPng = b[0] === 0x89 && b[1] === 0x50 && b[2] === 0x4E && b[3] === 0x47;
        const isWebp = b[0] === 0x52 && b[1] === 0x49 && b[2] === 0x46 && b[3] === 0x46;

        if (!isJpg && !isPng && !isWebp) {
          alert('Güvenlik Uyarısı: Sadece gerçek JPG, PNG veya WEBP görsel dosyaları yüklenebilir!');
          return;
        }

        ceBtnUploadImage.disabled = true;
        ceBtnUploadImage.innerText = 'Yükleniyor...';

        try {
          const formData = new FormData();
          formData.append('image', file);

          const res = await fetch(`https://api.imgbb.com/1/upload?key=${apiKey}`, {
            method: 'POST',
            body: formData
          });

          if (!res.ok) throw new Error('ImageBB yükleme başarısız!');
          const data = await res.json();
          const cdnUrl = data?.data?.url;

          if (cdnUrl) {
            if (ceCoverImage) ceCoverImage.value = cdnUrl;
            if (ceBodyHtml) {
              ceBodyHtml.value = `<img src="${cdnUrl}" alt="${ceTitle ? ceTitle.value : 'Görsel'}" class="my-6 rounded-2xl w-full object-cover max-h-96" />\n` + ceBodyHtml.value;
              runQualityGateCheck();
            }
            alert('✓ Görsel ImageBB CDN sunucularına başarıyla yüklendi ve makaleye eklendi!');
          }
        } catch (err) {
          alert('Görsel yüklenirken hata: ' + err.message);
        } finally {
          ceBtnUploadImage.disabled = false;
          ceBtnUploadImage.innerText = 'Yükle';
        }
      });
    }

    // Reset Editor Mode (Clear Editing State)
    function resetEditorMode() {
      currentEditingArticleId = null;
      if (ceEditBanner) ceEditBanner.classList.add('hidden');
      if (ceCoverImage) ceCoverImage.value = '';
      updateCoverPreview('');
      if (ceBtnSavePb) ceBtnSavePb.innerText = "💾 PocketBase'e Yayınla 🚀";
      if (ceBtnSaveDraft) ceBtnSaveDraft.innerText = '📝 Taslak Olarak Kaydet';
    }

    // Start Editing an Existing Article
    function startEditArticle(art) {
      currentEditingArticleId = art.id;
      if (ceTitle) ceTitle.value = art.baslik || '';
      if (ceSlug) ceSlug.value = art.slug || '';
      if (ceCategory) ceCategory.value = art.kategori || 'Site Yönetimi';
      if (ceReadTime) ceReadTime.value = art.okumaSuresi || '4 dk okuma';
      if (ceCoverImage) {
        ceCoverImage.value = art.kapakGorsel || '';
        updateCoverPreview(art.kapakGorsel || '');
      }
      if (ceSeoTitle) ceSeoTitle.value = art.seoTitle || '';
      if (ceSeoDesc) ceSeoDesc.value = art.seoDescription || '';
      if (ceBodyHtml) ceBodyHtml.value = art.ozet || '';

      if (ceEditBanner) {
        ceEditBanner.innerHTML = `
          <div class="flex items-center gap-2">
            <span class="text-lg">✏️</span>
            <div>
              <div class="font-extrabold text-amber-950">Makale Düzenleniyor: "${art.baslik}"</div>
              <div class="text-[10px] text-amber-700">Veritabanı ID: ${art.id} • Slug: /yazilar/${art.slug}</div>
            </div>
          </div>
          <button type="button" id="btn-cancel-edit" class="px-3 py-1.5 rounded-xl bg-amber-200 hover:bg-amber-300 text-amber-900 font-bold text-xs transition cursor-pointer shrink-0">
            ✕ Düzenlemeyi İptal Et
          </button>
        `;
        ceEditBanner.classList.remove('hidden');
        document.getElementById('btn-cancel-edit')?.addEventListener('click', () => {
          resetEditorMode();
          if (ceTitle) ceTitle.value = '';
          if (ceSlug) ceSlug.value = '';
          if (ceBodyHtml) ceBodyHtml.value = '';
          runQualityGateCheck();
        });
      }

      if (ceBtnSavePb) ceBtnSavePb.innerText = '💾 Değişiklikleri Güncelle & Yayınla 🚀';
      if (ceBtnSaveDraft) ceBtnSaveDraft.innerText = '📝 Taslak Olarak Güncelle';

      if (ceEditorWrapper) {
        ceEditorWrapper.classList.remove('hidden');
        ceEditorWrapper.scrollIntoView({ behavior: 'smooth' });
      }

      runQualityGateCheck();
    }

    // Save Article to PocketBase (Create or Update)
    async function saveArticle(aktif = true) {
      if (!ceTitle || !ceBodyHtml || !ceSlug) return;
      const title = ceTitle.value.trim();
      const body = ceBodyHtml.value.trim();
      const slug = ceSlug.value.trim();

      if (!title || !body || !slug) {
        alert('Lütfen başlık, slug ve makale gövdesini eksiksiz doldurun!');
        return;
      }

      if (ceBtnSavePb) ceBtnSavePb.disabled = true;
      if (ceBtnSaveDraft) ceBtnSaveDraft.disabled = true;

      try {
        const payload = {
          baslik: title,
          slug: slug,
          ozet: body,
          kategori: ceCategory ? ceCategory.value : 'Site Yönetimi',
          kategoriRenk: 'blue',
          tarih: new Date().toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }),
          okumaSuresi: ceReadTime ? ceReadTime.value : '4 dk okuma',
          aktif: aktif,
          seoTitle: ceSeoTitle ? ceSeoTitle.value : title,
          seoDescription: ceSeoDesc ? ceSeoDesc.value : title,
          kapakGorsel: ceCoverImage ? ceCoverImage.value : '',
          kaynak: 'Çelebi Yönetim & Temizlik Otomasyon Masası',
          views: 0
        };

        let res;
        if (currentEditingArticleId) {
          res = await fetch(`${PB_BASE_URL}/api/collections/yazilar/records/${currentEditingArticleId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        } else {
          res = await fetch(`${PB_BASE_URL}/api/collections/yazilar/records`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        }

        if (!res.ok) {
          const errData = await res.json();
          throw new Error(JSON.stringify(errData));
        }

        const saved = await res.json();

        // Mark keyword as used if came from select and creating new
        if (!currentEditingArticleId) {
          const selectedOpt = ceKeywordSelect?.selectedOptions?.[0];
          const kwId = selectedOpt?.getAttribute('data-id');
          if (kwId) {
            try {
              await fetch(`${PB_BASE_URL}/api/collections/seo_keywords/records/${kwId}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ used: true, lastGenerated: new Date().toISOString() })
              });
              loadCeKeywords();
            } catch (e) {}
          }
        }

        if (cePublishAlert) {
          cePublishAlert.innerHTML = currentEditingArticleId
            ? `✓ Makale başarıyla güncellendi! ID: <strong>${saved.id}</strong> | Durum: <strong>${aktif ? 'Yayında 🚀' : 'Taslak 📝'}</strong>`
            : `✓ Makale başarıyla PocketBase veritabanına kaydedildi! ID: <strong>${saved.id}</strong> | Durum: <strong>${aktif ? 'Yayında 🚀' : 'Taslak 📝'}</strong>`;
          cePublishAlert.classList.remove('hidden');
          setTimeout(() => cePublishAlert.classList.add('hidden'), 7000);
        }

        resetEditorMode();
        loadCeArticles();

      } catch (err) {
        alert('PocketBase kayıt hatası: ' + err.message);
      } finally {
        if (ceBtnSavePb) ceBtnSavePb.disabled = false;
        if (ceBtnSaveDraft) ceBtnSaveDraft.disabled = false;
      }
    }

    if (ceBtnSavePb) {
      ceBtnSavePb.addEventListener('click', () => saveArticle(true));
    }
    if (ceBtnSaveDraft) {
      ceBtnSaveDraft.addEventListener('click', () => saveArticle(false));
    }

    // Load Articles from PocketBase (Sorted by newest first via sort=-id)
    async function loadCeArticles() {
      if (!ceArticlesList) return;
      ceArticlesList.innerHTML = `
        <div class="p-8 text-center text-slate-400 text-xs flex items-center justify-center gap-2">
          <svg class="animate-spin h-4 w-4 text-sky-600" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          <span>PocketBase makaleleri yükleniyor...</span>
        </div>
      `;

      try {
        let res = await fetch(`${PB_BASE_URL}/api/collections/yazilar/records?page=1&perPage=50&sort=-id`);
        if (!res.ok) {
          // Fallback if sort=-id is unsupported
          res = await fetch(`${PB_BASE_URL}/api/collections/yazilar/records?page=1&perPage=50`);
        }
        if (!res.ok) throw new Error('PocketBase HTTP ' + res.status);
        const data = await res.json();
        const parseDate = (d) => {
          if (!d) return 0;
          const str = String(d).trim();
          if (str.toLowerCase() === 'bugün' || str.toLowerCase() === 'yeni') return Date.now();

          const normalized = str
            .replace(/İ/g, 'i').replace(/I/g, 'i').replace(/ı/g, 'i')
            .replace(/Ş/g, 's').replace(/ş/g, 's')
            .replace(/Ğ/g, 'g').replace(/ğ/g, 'g')
            .replace(/Ü/g, 'u').replace(/ü/g, 'u')
            .replace(/Ö/g, 'o').replace(/ö/g, 'o')
            .replace(/Ç/g, 'c').replace(/ç/g, 'c')
            .toLowerCase();

          const months = {
            'ocak': 0, 'subat': 1, 'mart': 2, 'nisan': 3, 'mayis': 4, 'haziran': 5,
            'temmuz': 6, 'agustos': 7, 'eylul': 8, 'ekim': 9, 'kasim': 10, 'aralik': 11,
            'january': 0, 'february': 1, 'march': 2, 'april': 3, 'may': 4, 'june': 5,
            'july': 6, 'august': 7, 'september': 8, 'october': 9, 'november': 10, 'december': 11
          };

          const m = normalized.match(/^(\d{1,2})\s+([a-z]+)\s+(\d{4})/i);
          if (m && m[2] in months) {
            return new Date(parseInt(m[3], 10), months[m[2]], parseInt(m[1], 10)).getTime();
          }

          const parsed = Date.parse(str);
          if (!isNaN(parsed)) return parsed;

          return 0;
        };
        const items = (data.items || []).sort((a, b) => parseDate(b.tarih) - parseDate(a.tarih));

        if (!items || items.length === 0) {
          ceArticlesList.innerHTML = `
            <div class="p-8 text-center text-slate-400 text-xs">
              Henüz PocketBase'de yayınlanmış bir makale bulunmuyor. Yukarıdaki panelden ilk SEO makalenizi tek tıkla üretebilirsiniz!
            </div>
          `;
          return;
        }

        ceArticlesList.innerHTML = items.map((art) => `
          <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-slate-50/80 transition-colors p-3 rounded-2xl border-b border-slate-100 last:border-b-0">
            <div class="flex items-center gap-3 max-w-2xl min-w-0">
              ${art.kapakGorsel ? `
                <img
                  src="${art.kapakGorsel}"
                  alt="${art.baslik}"
                  class="w-16 h-12 object-cover rounded-xl border border-slate-200 shrink-0 bg-slate-100 shadow-2xs"
                  loading="lazy"
                />
              ` : `
                <div class="w-16 h-12 rounded-xl bg-slate-100 border border-slate-200 shrink-0 flex items-center justify-center text-slate-400 text-base">
                  📄
                </div>
              `}
              <div class="space-y-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-bold text-sm text-slate-900 truncate">${art.baslik}</span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold shrink-0 ${art.aktif ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' : 'bg-amber-100 text-amber-800 border border-amber-200'}">
                    ${art.aktif ? 'Yayında' : 'Taslak'}
                  </span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-sky-50 text-sky-800 border border-sky-200 shrink-0">
                    ${art.kategori || 'Genel'}
                  </span>
                  <span class="text-[10px] text-slate-400 shrink-0">• ${art.tarih || 'Yeni'}</span>
                </div>
                <div class="text-xs text-slate-500 font-mono truncate">
                  Slug: /yazilar/${art.slug}
                </div>
              </div>
            </div>

            <div class="flex items-center gap-2 shrink-0 flex-wrap self-end sm:self-auto">
              <a
                href="/yazilar/${art.slug}"
                target="_blank"
                class="px-3 py-1.5 text-xs font-bold text-sky-700 bg-sky-50 hover:bg-sky-100 border border-sky-200 rounded-xl transition-all"
              >
                Görüntüle ↗
              </a>
              <button
                type="button"
                data-action="edit-art"
                data-id="${art.id}"
                class="px-3 py-1.5 text-xs font-bold text-amber-800 bg-amber-50 hover:bg-amber-100 border border-amber-300 rounded-xl transition-all cursor-pointer flex items-center gap-1 shadow-xs"
              >
                <span>✏️</span>
                <span>Düzenle</span>
              </button>
              <button
                type="button"
                data-action="toggle-art-status"
                data-id="${art.id}"
                data-status="${art.aktif}"
                class="px-3 py-1.5 text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl border border-slate-200 transition-all cursor-pointer"
              >
                ${art.aktif ? 'Taslağa Al' : 'Yayınla'}
              </button>
              <button
                type="button"
                data-action="delete-art"
                data-id="${art.id}"
                class="p-1.5 text-slate-400 hover:text-red-600 rounded-lg transition-colors cursor-pointer"
                title="Sil"
              >
                ✕
              </button>
            </div>
          </div>
        `).join('');

        // Bind Edit buttons
        ceArticlesList.querySelectorAll('[data-action="edit-art"]').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const art = data.items.find(x => x.id === id);
            if (art) startEditArticle(art);
          });
        });

        // Bind article actions (toggle status)
        ceArticlesList.querySelectorAll('[data-action="toggle-art-status"]').forEach(btn => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            const currentStatus = btn.getAttribute('data-status') === 'true';
            try {
              await fetch(`${PB_BASE_URL}/api/collections/yazilar/records/${id}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ aktif: !currentStatus })
              });
              loadCeArticles();
            } catch (e) {
              alert('Durum güncellenirken hata oluştu: ' + e.message);
            }
          });
        });

        // Bind delete buttons
        ceArticlesList.querySelectorAll('[data-action="delete-art"]').forEach(btn => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            if (confirm('Bu makaleyi PocketBase veritabanından kalıcı olarak silmek istediğinize emin misiniz?')) {
              try {
                await fetch(`${PB_BASE_URL}/api/collections/yazilar/records/${id}`, {
                  method: 'DELETE'
                });
                loadCeArticles();
              } catch (e) {
                alert('Silinirken hata oluştu: ' + e.message);
              }
            }
          });
        });

      } catch (err) {
        console.error('loadCeArticles error:', err);
        if (ceArticlesList) {
          ceArticlesList.innerHTML = `
            <div class="p-6 text-center text-slate-500 text-xs space-y-2">
              <div class="text-rose-600 font-bold">⚠️ Makaleler yüklenirken hata oluştu: ${err.message || err}</div>
              <div class="text-[11px] text-slate-400 font-mono">Hedef: ${PB_BASE_URL || window.location.origin}/api/collections/yazilar/records</div>
              <button
                type="button"
                id="ce-btn-retry-load"
                class="px-3 py-1.5 bg-sky-50 hover:bg-sky-100 text-sky-700 font-bold rounded-xl border border-sky-200 transition-all cursor-pointer text-xs"
              >
                🔄 Yeniden Dene
              </button>
            </div>
          `;
          document.getElementById('ce-btn-retry-load')?.addEventListener('click', () => {
            loadCeArticles();
          });
        }
      }
    }

    window.loadCeArticles = loadCeArticles;

    if (ceBtnRefreshArticles) {
      ceBtnRefreshArticles.addEventListener('click', () => {
        loadCeArticles();
      });
    }

    // Initial check
    checkAuth();
  })();
</script>
  </body>
</html>
