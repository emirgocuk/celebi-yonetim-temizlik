          phoneFormatted: cfgPhoneFormatted.value.trim(),
          email: cfgEmail.value.trim(),
          workingHours: cfgWorkingHours.value.trim(),
          address: cfgAddress.value.trim(),
          mapsEmbedUrl: cfgMapsUrl.value.trim(),
        };

        localStorage.setItem('celebi_company_settings', JSON.stringify(newConfig));
