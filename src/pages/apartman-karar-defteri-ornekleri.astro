  <script is:inline>
    (() => {
      const inputs = {
        siteName: document.getElementById('kd-site-name'),
        district: document.getElementById('kd-district'),
        date: document.getElementById('kd-date'),
        units: document.getElementById('kd-units'),
        aidat: document.getElementById('kd-aidat'),
      };

      const defaults = {
        siteName: 'Örnek Palmiye Apartmanı',
        district: 'Çukurova / Adana',
        date: '22.11.2026',
        units: '32',
        aidat: '1.250',
      };

      function syncAllFields() {
        Object.keys(inputs).forEach((key) => {
          const val = (inputs[key]?.value || '').trim() || defaults[key];
          document.querySelectorAll(`[data-kd="${key}"]`).forEach((el) => {
            el.textContent = val;
          });
        });
        syncWaLinks();
      }

      function getCleanTemplateText(targetId) {
        const el = document.getElementById(targetId);
        return el ? (el.innerText || el.textContent || '').trim() : '';
      }

      function syncWaLinks() {
        document.querySelectorAll('.kd-wa-btn').forEach((a) => {
          const targetId = a.getAttribute('data-wa-target');
          if (!targetId) return;
          const body = getCleanTemplateText(targetId);
          const footer = '\n\nKaynak ve canlı düzenleme: https://celebiyonetim.com.tr/apartman-karar-defteri-ornekleri/';
          a.setAttribute('href', `https://wa.me/?text=${encodeURIComponent(body + footer)}`);
        });
      }

      Object.values(inputs).forEach((inp) => {
        inp?.addEventListener('input', syncAllFields);
      });

      document.querySelectorAll('.kd-copy-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const targetId = btn.getAttribute('data-copy-target');
          const tplId = btn.getAttribute('data-tpl-id') || targetId;
          const text = getCleanTemplateText(targetId);
          if (!text) return;

          try {
            await navigator.clipboard.writeText(text);
          } catch (_) {
            const ta = document.createElement('textarea');
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            ta.remove();
          }

          if (typeof window.celebiTrack === 'function') {
            window.celebiTrack('template_copy', { template_id: tplId, service_type: 'Site & Apartman Yönetimi' });
          }

          const orig = btn.innerHTML;
          btn.innerHTML = '✓ Kopyalandı!';
          btn.classList.add('bg-emerald-600');
          setTimeout(() => {
            btn.innerHTML = orig;
            btn.classList.remove('bg-emerald-600');
          }, 2000);
        });
      });

      document.querySelectorAll('.kd-print-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-print-target');
          const printTitle = btn.getAttribute('data-print-title') || 'Karar Defteri Örneği';
          const text = getCleanTemplateText(targetId);
          if (!text) return;

          const win = window.open('', '_blank', 'width=820,height=680');
          if (!win) return;
          const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
          win.document.write(
            '<!doctype html><html lang="tr"><head><meta charset="UTF-8"><title>' + esc(printTitle) + '</title>' +
            '<style>body{font-family:Arial,Helvetica,sans-serif;padding:40px;color:#0f172a;line-height:1.6;}h1{font-size:18px;border-bottom:2px solid #004AAD;padding-bottom:8px;margin-bottom:20px;}pre{white-space:pre-wrap;font-family:inherit;font-size:14px;}footer{margin-top:32px;font-size:11px;color:#64748b;border-top:1px solid #e2e8f0;padding-top:10px;}</style>' +
            '</head><body><h1>' + esc(printTitle) + '</h1><pre>' + esc(text) + '</pre>' +
            '<footer>Hazırlayan: Çelebi Yönetim ve Temizlik — 0 (322) 235 15 88 | celebiyonetim.com.tr</footer></body></html>'
          );
          win.document.close();
          win.focus();
          win.print();
        });
      });

      syncAllFields();
    })();
  </script>

