        btnSaveTimerSettings.innerText = 'Kaydediliyor...';

        try {
          const payload = {
            aktif: timerToggleActive ? timerToggleActive.checked : true,
            siklik: timerSelectFrequency ? timerSelectFrequency.value : '6h',
