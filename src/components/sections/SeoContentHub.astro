// Collect slugs pre-rendered statically at build time
const staticArticleSlugsJson = JSON.stringify(featuredArticles.map((a) => a.slug));
---
import { ARTICLES_DATA, parseDateToTime } from '@/lib/articles-data';

// Top articles displayed on the homepage (max 3 articles)
let featuredArticles = ARTICLES_DATA.slice(0, 3);
try {
  const pbRes = await fetch('https://celebiyonetim.com.tr/api/collections/yazilar/records?perPage=30', {
    headers: { 'User-Agent': 'Mozilla/5.0' }
  });
  if (pbRes.ok) {
    const data = await pbRes.json();
    const pbItems = data.items || [];
    if (pbItems.length > 0) {
      pbItems.sort((a: any, b: any) => parseDateToTime(b.tarih) - parseDateToTime(a.tarih));
      featuredArticles = pbItems.slice(0, 3).map((item: any) => {
        const plainText = (item.ozet || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 180) + '...';
        return {
          slug: item.slug,
          title: item.baslik,
          category: item.kategori || 'Site Yönetimi',
          tag: item.kategori || 'Rehber',
          tagColor: 'bg-sky-50 text-sky-800 border-sky-300',
          readTime: item.okumaSuresi || '4 dk okuma',
          publishDate: item.tarih || 'Güncel',
          isoDate: '',
          summary: plainText,
          image: item.kapakGorsel || '',
          author: { name: item.kaynak || 'Çelebi Hukuk Servisi', role: '' },
          keyTakeaways: ['634 Sayılı KMK Mevzuatı ile Tam Uyumlu', 'Adana Yerel Site Yönetimi Standartları'],
          content: { lead: '', sections: [] }
        };
      });
    }
  }
} catch (e) {
  // Silent fallback
}
// Collect slugs pre-rendered statically at build time
const staticArticleSlugsJson = JSON.stringify(featuredArticles.map((a) => a.slug));
---

<section id="yazilar" class="scroll-mt-24 py-20 sm:py-28 bg-gradient-to-b from-white via-slate-50 to-white border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    
    <!-- Section Heading with "Tüm Yazıları Oku" CTA -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-14">
      <div class="lg:col-span-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-sky-50 text-sky-800 border border-sky-200 mb-3">
          <span>Sektörel Rehber & Makaleler</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
          Site Yönetimi ve Profesyonel Temizlikte Yasal & Teknik Rehber
        </h2>
        <p class="text-base text-slate-600 leading-relaxed font-normal">
          Kat Mülkiyeti Kanunu (KMK) mevzuatı, aidat tahsilat protokolleri, iş sağlığı güvenliği (İSG) standartları ve kurumsal temizlik metotları hakkında aradığınız tüm yasal ve pratik bilgiler.
        </p>
      </div>

      <!-- "Tüm Yazıları Oku" Action Button -->
      <div class="lg:col-span-4 flex lg:justify-end">
        <a
          href="/yazilar"
          class="inline-flex items-center gap-2 px-6 py-3.5 text-xs sm:text-sm font-bold text-white bg-slate-900 hover:bg-sky-700 rounded-2xl shadow-md transition-all duration-150 subtle-tap"
        >
          <span>Tüm Yazıları Oku</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- Structured Topic Articles with Rich Authority & Direct Read Links -->
    <div id="home-articles-container" data-static-slugs={staticArticleSlugsJson} class="space-y-6 text-slate-700">
      {featuredArticles.map((article) => (
        <article class="home-article-card rounded-3xl bg-white border border-slate-200 p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-200 group">
          <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <div class="flex items-center gap-2.5">
              <span class={`px-2.5 py-1 rounded-md text-[11px] font-bold border ${article.tagColor}`}>
                {article.tag}
              </span>
              <span class="text-xs text-slate-400">• {article.readTime}</span>
            </div>
            <span class="text-xs text-slate-400 font-medium">{article.publishDate}</span>
          </div>

          <h3 class="text-xl sm:text-2xl font-bold text-slate-900 mb-3 group-hover:text-sky-700 transition-colors">
            <a href={`/yazilar/${article.slug}`}>
              {article.title}
            </a>
          </h3>

          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6 font-normal">
            {article.summary}
          </p>

          <!-- Quick Takeaways Pills -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-2 mb-6">
            {article.keyTakeaways.slice(0, 2).map((takeaway) => (
              <div class="flex items-start gap-2 p-2.5 rounded-xl bg-slate-50 border border-slate-100 text-[11px] sm:text-xs text-slate-700">
                <span class="text-emerald-600 font-bold shrink-0">✓</span>
                <span class="line-clamp-2">{takeaway}</span>
              </div>
            ))}
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs text-slate-500 font-medium">Yazar: {article.author.name}</span>
            <a
              href={`/yazilar/${article.slug}`}
              class="inline-flex items-center gap-1.5 text-xs font-bold text-sky-700 hover:text-sky-900 transition-colors"
            >
              <span>Yazının Devamını Oku</span>
              <span>→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom Read All Bar -->
    <div class="mt-12 p-6 sm:p-8 rounded-3xl bg-slate-900 text-white flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl">
      <div>
        <h4 class="text-base sm:text-lg font-bold mb-1">Daha Fazla Hukuki ve Teknik Yazı mı Arıyorsunuz?</h4>
        <p class="text-xs sm:text-sm text-slate-300">Tüm makale, yönetmelik özeti ve sektörel rehberlerimizi inceleyin.</p>
      </div>
      <a
        href="/yazilar"
        class="shrink-0 px-6 py-3 text-xs sm:text-sm font-bold text-slate-900 bg-white hover:bg-sky-100 rounded-xl transition-all duration-150 subtle-tap shadow-md"
      >
        Tüm Yazıları Oku →
      </a>
    </div>

    <!-- Keyword & Service Area Tags Strip for Search Clustering -->
    <div class="mt-12 pt-8 border-t border-slate-200 text-xs text-slate-500">
      <div class="font-bold text-slate-800 uppercase tracking-wider mb-3">Popüler Arama Konuları ve Hizmet Bölgeleri</div>
      <div class="flex flex-wrap gap-2">
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">Site Yönetimi Şirketleri</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">Apartman Aidat Takip Sistemi</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">Kat Mülkiyeti Kanunu Danışmanlık</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">Kurumsal Ofis Temizliği</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">İnşaat Sonrası Daire Temizliği</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">Dış Cephe Cam Yıkama Vinçli</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">Haftalık Merdiven Temizliği Sözleşmesi</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">Asansör Periyodik Bakım Takibi</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">İşletme Projesi Hazırlama</span>
        <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 shadow-sm font-medium">Rezidans ve Plaza Tesis Yönetimi</span>
      </div>
    </div>

  </div>
</section>

<!-- Homepage Live PocketBase Hydration -->
<script is:inline>
  (async () => {
    const container = document.getElementById('home-articles-container');
    if (!container) return;

    // Parse Turkish or ISO date string to millisecond timestamp for sorting
    function parseArticleDate(dateStr) {
      if (!dateStr) return 0;
      const str = String(dateStr).trim();
      if (str.toLowerCase() === 'bugün' || str.toLowerCase() === 'yeni') return Date.now();

      const normalized = str
        .replace(/İ/g, 'i').replace(/I/g, 'i').replace(/ı/g, 'i')
        .replace(/Ş/g, 's').replace(/ş/g, 's')
        .replace(/Ğ/g, 'g').replace(/ğ/g, 'g')
        .replace(/Ü/g, 'u').replace(/ü/g, 'u')
        .replace(/Ö/g, 'o').replace(/ö/g, 'o')
        .replace(/Ç/g, 'c').replace(/ç/g, 'c')
        .toLowerCase();

      const months = {
        'ocak': 0, 'subat': 1, 'mart': 2, 'nisan': 3, 'mayis': 4, 'haziran': 5,
        'temmuz': 6, 'agustos': 7, 'eylul': 8, 'ekim': 9, 'kasim': 10, 'aralik': 11,
        'january': 0, 'february': 1, 'march': 2, 'april': 3, 'may': 4, 'june': 5,
        'july': 6, 'august': 7, 'september': 8, 'october': 9, 'november': 10, 'december': 11
      };

      const m = normalized.match(/^(\d{1,2})\s+([a-z]+)\s+(\d{4})/i);
      if (m && m[2] in months) {
        return new Date(parseInt(m[3], 10), months[m[2]], parseInt(m[1], 10)).getTime();
      }

      const parsed = Date.parse(str);
      if (!isNaN(parsed)) return parsed;

      return 0;
    }

    // Checks if article was published today (disappears tomorrow)
    function isArticleNew(dateStr) {
      if (!dateStr) return false;
      const str = String(dateStr).trim();
      if (str.toLowerCase() === 'bugün' || str.toLowerCase() === 'yeni') return true;

      const artTimestamp = parseArticleDate(dateStr);
      if (artTimestamp > 0) {
        const now = new Date();
        const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
        const diffHours = (Date.now() - artTimestamp) / (1000 * 60 * 60);
        return artTimestamp >= todayStart || (diffHours >= 0 && diffHours < 24);
      }

      return false;
    }

    const PB_BASE_URL = (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1')
      ? 'http://127.0.0.1:8090'
      : '';

    const staticSlugs = new Set();
    try {
      const raw = container.getAttribute('data-static-slugs');
      if (raw) JSON.parse(raw).forEach((s) => staticSlugs.add(s));
    } catch (_) {}
    const articleUrl = (slug) => (staticSlugs.has(slug) ? `/yazilar/${slug}` : `/yazilar/oku?slug=${slug}`);

    try {
      let res = await fetch(`${PB_BASE_URL}/api/collections/yazilar/records?perPage=30`);
      if (res.ok) {
        const data = await res.json();
        const pbArticles = data.items || [];
        if (pbArticles.length > 0) {
          // Sort PB articles by date descending
          pbArticles.sort((a, b) => parseArticleDate(b.tarih) - parseArticleDate(a.tarih));
          const top3 = pbArticles.slice(0, 3);

          const newCards = top3.map((item) => {
            const tmp = document.createElement('div');
            tmp.innerHTML = item.ozet || '';
            const plainText = (tmp.querySelector('p')?.innerText || tmp.innerText || item.baslik).slice(0, 180) + '...';
            const isNew = isArticleNew(item.tarih);

            return `
              <article class="home-article-card rounded-3xl bg-white border border-sky-200 p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-200 group ring-1 ring-sky-100">
                <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                  <div class="flex items-center gap-2.5">
                    <span class="px-2.5 py-1 rounded-md text-[11px] font-bold border bg-sky-50 text-sky-800 border-sky-300">
                      ${item.kategori || 'Site Yönetimi'}
                    </span>
                    ${isNew ? `
                      <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-500 text-white flex items-center gap-1 shadow-xs">
                        <span class="w-1 h-1 rounded-full bg-white animate-pulse"></span> Yeni
                      </span>
                    ` : ''}
                    <span class="text-xs text-slate-400">• ${item.okumaSuresi || '4 dk okuma'}</span>
                  </div>
                  <span class="text-xs text-slate-400 font-medium">${item.tarih || 'Güncel'}</span>
                </div>

                <h3 class="text-xl sm:text-2xl font-bold text-slate-900 mb-3 group-hover:text-sky-700 transition-colors">
                  <a href="${articleUrl(item.slug)}">
                    ${item.baslik}
                  </a>
                </h3>

                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6 font-normal">
                  ${plainText}
                </p>

                <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                  <span class="text-xs text-slate-500 font-medium">Yazar: ${item.kaynak || 'Çelebi Hukuk Servisi'}</span>
                  <a
                    href="${articleUrl(item.slug)}"
                    class="inline-flex items-center gap-1.5 text-xs font-bold text-sky-700 hover:text-sky-900 transition-colors"
                  >
                    <span>Yazının Devamını Oku</span>
                    <span>→</span>
                  </a>
                </div>
              </article>
            `;
          });

          container.innerHTML = newCards.join('');
        }
      }
    } catch (e) {
      console.warn('Home articles hydration error:', e);
    }
  })();
</script>
