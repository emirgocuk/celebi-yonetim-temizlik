# Çelebi Yönetim ve Temizlik - Ortam Değişkenleri (Environment Variables)

# 1. PocketBase Yapılandırması
POCKETBASE_URL=http://127.0.0.1:8090
PUBLIC_POCKETBASE_URL=https://celebiyonetim.com.tr/api
POCKETBASE_ADMIN_EMAIL=emrggck@gmail.com
POCKETBASE_ADMIN_PASSWORD=Awseqdll.12

# 2. Yapay Zeka / LLM Makale Motoru (OpenRouter)
# https://openrouter.ai/keys adresinden ücretsiz key alabilirsiniz.
OPENROUTER_API_KEY=
PUBLIC_OPENROUTER_API_KEY=

# 3. Görsel Barındırma (ImageBB)
# https://api.imgbb.com adresinden ücretsiz key alabilirsiniz.
IMGBB_API_KEY=
PUBLIC_IMGBB_API_KEY=

# 4. Reklam & Dönüşüm İzleme (GA4, Google Ads, Meta Pixel)
# Boş bırakılırsa /merkez > İletişim & Ayarlar ekranındaki PocketBase ayarlarından otomatik okunur.
PUBLIC_GA4_ID=
PUBLIC_GADS_ID=
PUBLIC_GADS_CONV_LEAD=
PUBLIC_GADS_CONV_WHATSAPP=
PUBLIC_GADS_CONV_CALL=
PUBLIC_META_PIXEL_ID=

